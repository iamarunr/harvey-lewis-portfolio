---
// The site's whole motion layer. Three behaviours, all opt-in per element:
//   data-reveal        — fade + rise into view
//   data-reveal-group  — stagger this element's [data-reveal] children
//   data-count         — count a numeral up when it scrolls into view
// Everything degrades to the finished state when JS or IntersectionObserver
// is unavailable, or when the visitor prefers reduced motion.
---

<script>
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');

  function initReveals() {
    // Stagger: give each child of a group an incrementing delay before observing.
    document.querySelectorAll<HTMLElement>('[data-reveal-group]').forEach((group) => {
      const step = Number(group.dataset.revealStep ?? 80);
      group
        .querySelectorAll<HTMLElement>('[data-reveal]')
        .forEach((child, i) => child.style.setProperty('--reveal-delay', `${i * step}ms`));
    });

    const targets = [...document.querySelectorAll<HTMLElement>('[data-reveal]')];
    if (!targets.length) return;

    const reveal = (el: Element) => el.classList.add('is-visible');

    if (reduced.matches || !('IntersectionObserver' in window)) {
      targets.forEach(reveal);
      return;
    }

    // Single non-thrashing IntersectionObserver: browser reports what is already in viewport
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          reveal(entry.target);
          observer.unobserve(entry.target);
        });
      },
      { threshold: 0.05, rootMargin: '0px 0px -4% 0px' }
    );

    targets.forEach((el) => observer.observe(el));

    // Last-resort safety net: whatever the observer has not reached after a few seconds gets shown anyway
    window.setTimeout(() => {
      targets.forEach((el) => {
        if (!el.classList.contains('is-visible')) {
          reveal(el);
          observer.unobserve(el);
        }
      });
    }, 3000);
  }

  function initCounters() {
    const targets = document.querySelectorAll<HTMLElement>('[data-count]');
    if (!targets.length) return;

    // Parse "450", "2×", "64k", "TBC" — animate the numeric part, keep the affixes.
    const parse = (raw: string) => {
      const match = raw.match(/^(\D*)(\d[\d,.]*)(.*)$/s);
      if (!match) return null;
      return {
        prefix: match[1],
        value: Number(match[2].replace(/,/g, '')),
        suffix: match[3],
        decimals: (match[2].split('.')[1] ?? '').length,
      };
    };

    if (reduced.matches || !('IntersectionObserver' in window)) return;

    const run = (el: HTMLElement) => {
      const final = el.textContent?.trim() ?? '';
      const parsed = parse(final);
      if (!parsed) return;

      if (document.visibilityState !== 'visible') {
        document.addEventListener('visibilitychange', () => run(el), { once: true });
        return;
      }

      const { prefix, value, suffix, decimals } = parsed;
      const duration = 1400;
      const start = performance.now();
      el.classList.add('counting');

      const tick = (now: number) => {
        const t = Math.min((now - start) / duration, 1);
        if (t >= 1) {
          el.textContent = final;
          return;
        }
        const eased = 1 - Math.pow(1 - t, 3);
        const shown = (value * eased).toFixed(decimals);
        el.textContent = `${prefix}${Number(shown).toLocaleString('en-US', {
          minimumFractionDigits: decimals,
          maximumFractionDigits: decimals,
        })}${suffix}`;
        requestAnimationFrame(tick);
      };

      requestAnimationFrame(tick);
    };

    const countObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          countObserver.unobserve(entry.target);
          run(entry.target as HTMLElement);
        });
      },
      { threshold: 0.3 }
    );

    targets.forEach((el) => countObserver.observe(el));
  }

  function initHeader() {
    const header = document.querySelector<HTMLElement>('[data-site-header]');
    if (!header) return;
    const onScroll = () => header.classList.toggle('is-scrolled', window.scrollY > 12);
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
  }

  function initProgress() {
    let bar = document.getElementById('reading-progress');
    if (!bar) {
      bar = document.createElement('div');
      bar.id = 'reading-progress';
      document.body.prepend(bar);
    }
    const onScroll = () => {
      const max = document.documentElement.scrollHeight - window.innerHeight;
      if (max <= 0) return;
      const pct = Math.min(100, Math.max(0, (window.scrollY / max) * 100));
      bar!.style.width = `${pct}%`;
    };
    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();
  }

  // "Show all N" / "Show fewer" for any long list
  function initDisclosures() {
    document.querySelectorAll<HTMLButtonElement>('[data-more-toggle]').forEach((button) => {
      const panel = document.getElementById(button.dataset.moreToggle ?? '');
      if (!panel) return;

      button.addEventListener('click', () => {
        const open = panel.classList.toggle('is-open');
        button.setAttribute('aria-expanded', String(open));
        const label = open ? button.dataset.labelLess : button.dataset.labelMore;
        if (label) button.textContent = label;

        if (!open) {
          const top = panel.parentElement?.getBoundingClientRect().top ?? 0;
          if (top < 0) {
            panel.parentElement?.scrollIntoView({
              behavior: reduced.matches ? 'auto' : 'smooth',
              block: 'start',
            });
          }
        }
      });
    });
  }

  // Phone navigation disclosure. The links sit inline in the markup and only
  // collapse under CSS gated on .js-motion, so this never hides the nav from
  // anyone the script didn't reach.
  function initNav() {
    document.querySelectorAll<HTMLButtonElement>('[data-nav-toggle]').forEach((toggle) => {
      const panel = document.getElementById(toggle.getAttribute('aria-controls') ?? '');
      if (!panel) return;

      const setOpen = (open: boolean) => {
        panel.classList.toggle('is-open', open);
        toggle.setAttribute('aria-expanded', String(open));
        toggle.setAttribute('aria-label', open ? 'Close navigation menu' : 'Open navigation menu');
      };

      toggle.addEventListener('click', () => {
        setOpen(toggle.getAttribute('aria-expanded') !== 'true');
      });

      // Following a link should close the panel behind you.
      panel.querySelectorAll('a').forEach((link) => {
        link.addEventListener('click', () => setOpen(false));
      });

      document.addEventListener('keydown', (event) => {
        if (event.key !== 'Escape') return;
        if (toggle.getAttribute('aria-expanded') !== 'true') return;
        setOpen(false);
        toggle.focus();
      });

      // Rotating to landscape can cross into the desktop layout, where the panel
      // styles no longer apply — drop the open state so it can't strand.
      window.matchMedia('(min-width: 861px)').addEventListener('change', (event) => {
        if (event.matches) setOpen(false);
      });
    });
  }

  function init() {
    initReveals();
    initCounters();
    initHeader();
    initProgress();
    initDisclosures();
    initNav();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init, { once: true });
  } else {
    init();
  }
</script>
