---
import Base from '../layouts/Base.astro';
import Arrow from '../components/Arrow.astro';
import nav from '../data/nav.json';
---

<Base title="Page not found — Harvey Lewis" description="This page doesn't exist, has moved, or was mistyped." noindex>
  <header class="page-head nf-head">
    <p class="nf-num" aria-hidden="true">404</p>
    <h1 class="display-1">The course doesn't go this way.</h1>
    <p class="lede">The page may have moved, been retired, or been mistyped. Pick the route back up from here.</p>
  </header>
  <nav class="wrap nf-nav" aria-label="Pages">
    <ul class="close-list nf-list">
      <li><a href="/"><span class="cl-name">Home</span><span class="cl-desc">The short version, in one scroll.</span><Arrow /></a></li>
      {nav.map((n) => <li><a href={n.href}><span class="cl-name">{n.label}</span><span class="cl-desc"></span><Arrow /></a></li>)}
      <li><a href="/contact"><span class="cl-name">Contact</span><span class="cl-desc">Sponsorship, speaking and media.</span><Arrow /></a></li>
    </ul>
  </nav>
</Base>

<style is:global>
  .nf-num { font-family: var(--display); font-weight: 900; font-size: clamp(120px, 22vw, 360px); line-height: 0.8; color: var(--line); }
  .nf-head .display-1 { max-width: 12ch; }
  .nf-nav { padding-bottom: var(--sec); }
  .nf-list { border-top-color: var(--ink); }
  .nf-list a { border-bottom-color: var(--rule); }
  .nf-list a:hover { color: var(--line); }
</style>
