---
import { Image } from 'astro:assets';
import students from '../assets/photos/speaking-students.jpg';
import talks from '../data/talks.json';
import site from '../data/site.json';

const speakingHref = `mailto:${site.enquiryEmail}?subject=${encodeURIComponent('Speaking enquiry')}`;

const audiences = [
  'Corporate Teams & Leadership',
  'Middle & High Schools',
  'Universities & Commencements',
  'Race Expos & Banquets',
];

const proof = [
  { value: '108', label: 'Continuous hours on foot' },
  { value: '2×', label: 'Rich Roll Podcast guest' },
  { value: '180', label: 'Days in class each year' },
];

const facts = [
  { label: 'Formats', value: '30–60 min keynotes, fireside chats, Q&A' },
  { label: 'Home base', value: 'Cincinnati, OH (CVG) · speaks worldwide' },
  { label: 'Booking', value: 'Arranged year-round around school terms' },
];
---

<section id="speaking" class="band-deep">
  <div class="section-inner">
    <div class="eyebrow">Speaking &amp; Keynotes</div>

    <div class="split" data-reveal-group data-reveal-step="110">
      <div data-reveal>
        <h2>A teacher who can tell you what the fifth day feels like</h2>
        <p class="lede">
          Specific, unhurried, evidence first. No hype. Harvey brings the mindset of 108 continuous hours of endurance directly to corporate teams and students.
        </p>

        <div class="audience-tags">
          {audiences.map((aud) => <span class="aud-tag">{aud}</span>)}
        </div>

        <div class="talks hairline-grid" data-reveal-group data-reveal-step="90">
          {
            talks.map((talk) => (
              <div class="talk lift" data-reveal>
                <div class="talk-tag">{talk.tag}</div>
                <h3 class="talk-title">{talk.title}</h3>
                <p>{talk.body}</p>
              </div>
            ))
          }
        </div>
      </div>

      <div class="speaking-sidebar" data-reveal>
        <div class="photo-box">
          <Image
            src={students}
            alt="Harvey Lewis speaking with students outdoors"
            class="speaking-photo"
            widths={[400, 800, 1200]}
            sizes="(max-width: 800px) 90vw, 640px"
            loading="lazy"
          />
        </div>

        <div class="speaking-proof hairline-grid">
          {
            proof.map((p) => (
              <div class="proof-stat">
                <span class="proof-num">{p.value}</span>
                <span class="proof-lbl">{p.label}</span>
              </div>
            ))
          }
        </div>

        <div class="facts hairline-grid">
          {
            facts.map((fact) => (
              <div class="fact">
                <span class="fact-label">{fact.label}</span>
                <span class="fact-value">{fact.value}</span>
              </div>
            ))
          }
        </div>

        <div class="speaking-actions">
          <a href={speakingHref} class="speaking-cta btn-solid">Check a date →</a>
          <a href="/media" class="speaking-secondary">Media kit &amp; bio →</a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .split {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 460px), 1fr));
    gap: clamp(36px, 5vw, 84px);
    margin-top: 28px;
    align-items: stretch;
  }

  h2 {
    font-weight: 600;
    font-size: clamp(32px, 3.6vw, 56px);
    line-height: 1.08;
    letter-spacing: -0.02em;
    max-width: 22ch;
  }

  .lede {
    margin-top: 20px;
    font-size: clamp(18px, 1.2vw, 22px);
    line-height: 1.62;
    color: var(--ink-subtle);
    max-width: 48ch;
    text-wrap: pretty;
  }

  .audience-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 24px;
  }

  .aud-tag {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-dim);
    background: var(--bg);
    border: 1px solid var(--line);
    padding: 6px 12px;
  }

  .talks {
    margin-top: 32px;
    display: flex;
    flex-direction: column;
    gap: 1px;
  }

  .talk {
    background: var(--bg-deep);
    padding: clamp(24px, 2.2vw, 32px) clamp(22px, 2vw, 30px);
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-height: 140px;
    flex: 1;
  }

  .talk-tag {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--rust);
  }

  .talk-title {
    font-weight: 600;
    font-size: clamp(20px, 1.4vw, 24px);
    line-height: 1.25;
    margin-top: 8px;
  }

  .talk p {
    margin-top: 8px;
    font-size: clamp(15px, 1vw, 17px);
    line-height: 1.6;
    color: var(--ink-dim);
    text-wrap: pretty;
  }

  .speaking-sidebar {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .photo-box {
    border: 1px solid var(--line);
    overflow: hidden;
  }

  .speaking-photo {
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
  }

  .speaking-proof {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    margin-top: 10px;
  }

  .proof-stat {
    background: var(--bg);
    padding: 16px 10px;
    text-align: center;
  }

  .proof-num {
    font-family: var(--font-num);
    font-size: clamp(28px, 2.8vw, 38px);
    line-height: 1;
    color: var(--rust);
    display: block;
  }

  .proof-lbl {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--ink-dim);
    margin-top: 6px;
    display: block;
    line-height: 1.25;
  }

  .facts {
    margin-top: 10px;
  }

  .fact {
    background: var(--bg);
    padding: 16px 20px;
    display: flex;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
    font-size: 14px;
  }

  .fact-label {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-dim);
  }

  .fact-value {
    text-align: right;
    font-weight: 500;
    color: var(--ink);
  }

  .speaking-actions {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin-top: 16px;
  }

  .speaking-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 16px 24px;
    min-height: 48px;
    background: var(--rust);
    color: var(--bg);
    font-weight: 600;
    text-align: center;
    transition: background-color 0.15s ease;
  }

  .speaking-cta:hover {
    background: var(--ink);
  }

  .speaking-secondary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 12px 20px;
    min-height: 44px;
    border: 1px solid var(--line);
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-dim);
    transition: color 0.15s ease, border-color 0.15s ease, background-color 0.15s ease;
  }

  .speaking-secondary:hover {
    color: var(--ink);
    border-color: var(--ink);
    background: var(--surface-hover);
  }
</style>
