---
import { Image } from 'astro:assets';
import saltFlat from '../assets/photos/salt-flat-sunset.jpg';
---

<section class="photo-band">
  <Image
    src={saltFlat}
    alt="Harvey Lewis running across Badwater Basin salt flats at sunset in Death Valley"
    class="band-photo"
    widths={[900, 1440, 2000, 2560]}
    sizes="100vw"
    loading="lazy"
  />
  <div class="band-scrim"></div>
  <div class="band-copy">
    <div class="container band-copy-inner" data-reveal>
      <div class="eyebrow eyebrow-rust">Badwater 135 · Death Valley</div>
      <h2 class="band-headline">
        135 miles across the hottest place on Earth. Fifteen finishes, two victories, and a celebration of what the human spirit can endure.
      </h2>
    </div>
  </div>
</section>

<style>
  .photo-band {
    position: relative;
    overflow: hidden;
  }

  .band-photo {
    width: 100%;
    height: clamp(380px, 60vh, 720px);
    object-fit: cover;
  }

  .band-scrim {
    position: absolute;
    inset: 0;
    background: var(--scrim-band);
  }

  .band-copy {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    padding: clamp(40px, 6vw, 72px) 0;
  }

  .band-copy-inner {
    max-width: var(--max-w);
    margin: 0 auto;
  }

  .band-headline {
    font-weight: 600;
    font-size: clamp(28px, 3.5vw, 54px);
    line-height: 1.1;
    letter-spacing: -0.015em;
    margin-top: 18px;
    max-width: 30ch;
  }
</style>
