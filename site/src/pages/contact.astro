---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Arrow from '../components/Arrow.astro';
import site from '../data/site.json';
import enquiries from '../data/enquiries.json';
import portrait from '../assets/photos/sunset-portrait.jpg';

const mail = (subject: string) => `mailto:${site.enquiryEmail}?subject=${encodeURIComponent(subject)}`;
const routes = enquiries.map((e) => ({ ...e, id: e.eyebrow.split('/ ')[1]?.toLowerCase() ?? '' }));

const sponsors = [
  { name: 'Brooks Running', cat: 'Footwear & apparel' },
  { name: 'InsideTracker', cat: 'Blood biomarker testing' },
  { name: 'Dream Recovery', cat: 'Sleep optimization' },
];

const affiliations = [
  { name: 'Team USA — IAU 24-Hour', note: '5 appearances (2012–2019) — a U.S. record' },
  { name: 'RunQuest Travel', note: 'Harvey\'s international running expedition company', url: 'https://www.runquesttravel.com' },
  { name: 'Charity Miles', note: 'Featured athlete and podcast guest', url: 'https://charitymiles.org/harvey-lewis/' },
  { name: 'Great Vegan Athletes', note: 'Profiled as a leading plant-based endurance athlete', url: 'https://www.greatveganathletes.com/harvey-lewis-ultramarathon-runner/' },
];

const socials = [
  { label: 'Instagram', handle: '@harveylewisultrarunner', url: 'https://www.instagram.com/harveylewisultrarunner' },
  { label: 'Chasing Democracy', handle: '@chasingdemocracy250', url: 'https://www.instagram.com/chasingdemocracy250' },
  { label: 'Facebook', handle: '@harveylewisultrarunner', url: 'https://www.facebook.com/harveylewisultrarunner' },
  { label: 'X / Twitter', handle: '@harveylewisruns', url: 'https://twitter.com/harveylewisruns' },
  { label: 'YouTube', handle: 'Harvey and Kelly', url: 'https://www.youtube.com/@HarveyandKelly' },
];
---

<Base title="Contact — Harvey Lewis" description="Sponsorship, speaking and media enquiries for Cincinnati high school teacher and ultrarunner Harvey Lewis.">
  <section class="yellow contact-head" aria-labelledby="contact-h">
    <div class="contact-head-text">
      <h1 id="contact-h" class="display-1">Work with Harvey.</h1>
      <p class="lede">
        He reads every message himself. Pick the route that fits, or write to
        <a class="inline-link" href={`mailto:${site.enquiryEmail}`}>{site.enquiryEmail}</a>.
      </p>
    </div>
    <ul class="close-list contact-routes">
      {
        routes.map((r) => (
          <li id={r.id}>
            <a href={mail(r.subject)}>
              <span class="cl-name">{r.title}</span>
              <span class="cl-desc">{r.body}</span>
              <Arrow />
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="wrap sec contact-body">
    <figure class="contact-photo">
      <Image src={portrait} alt="Harvey Lewis standing arms crossed on a road at dusk, wooded hills behind him" widths={[340, 640]} sizes="(max-width: 900px) 70vw, 340px" />
      <figcaption class="dim">Dream Big, 2026. Photograph by Mike Trimpe</figcaption>
    </figure>

    <div>
      <h2 class="display-3">Follow along</h2>
      <ul class="index socials">
        {
          socials.map((s) => (
            <li>
              <a href={s.url} target="_blank" rel="noopener noreferrer">
                <span class="social-label">{s.label}</span>
                <span class="social-handle dim">{s.handle}</span>
                <Arrow class="ne" />
                <span class="visually-hidden">(opens in a new tab)</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div>
      <h2 class="display-3">Partners</h2>
      <ul class="index partners">
        {sponsors.map((s) => (
          <li><span class="partner-name">{s.name}</span><span class="label dim">{s.cat}</span></li>
        ))}
      </ul>
      <h2 class="display-3 affil-h">Affiliations</h2>
      <ul class="index partners">
        {affiliations.map((a) => (
          <li>
            {a.url ? <a class="partner-name inline-link" href={a.url} rel="noopener noreferrer" target="_blank">{a.name}</a> : <span class="partner-name">{a.name}</span>}
            <span class="partner-note dim">{a.note}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>
</Base>

<style is:global>
  .arrow.ne { transform: rotate(-45deg); }
  a:hover > .arrow.ne { transform: rotate(-45deg) translateX(4px); }

  .contact-head { padding: calc(96px + clamp(40px, 7vw, 120px)) var(--gut) var(--sec); display: grid; gap: clamp(48px, 6vw, 96px); }
  .contact-head-text { display: grid; gap: clamp(24px, 3vw, 40px); }
  .contact-head .inline-link:hover { color: var(--dark-dim); }
  .contact-routes li { scroll-margin-top: 120px; }

  .contact-body { display: grid; grid-template-columns: minmax(0, 340px) minmax(0, 1fr) minmax(0, 1fr); gap: 56px clamp(32px, 5vw, 96px); align-items: start; }
  .contact-photo img { width: 100%; }
  .contact-photo figcaption { margin-top: 10px; }
  .socials, .partners { margin-top: 24px; }
  .socials a { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 2px 16px; padding: 14px 0; text-decoration: none; }
  .social-label { font-family: var(--display); font-weight: 750; font-size: 22px; text-transform: uppercase; letter-spacing: 0.03em; }
  .social-handle { grid-column: 1; font-size: 17px; }
  .socials .arrow { grid-column: 2; grid-row: 1 / span 2; align-self: center; color: var(--line); }
  .socials a:hover .social-label { color: var(--line); }
  .partners li { display: grid; gap: 2px; padding: 14px 0; }
  .partner-name { font-size: 19px; font-weight: 560; }
  a.partner-name { display: inline-flex; align-items: center; min-height: 44px; margin: -8px 0; }
  .partner-note { font-size: 17px; }
  .affil-h { margin-top: 56px; }

  @media (max-width: 1100px) {
    .contact-body { grid-template-columns: 1fr 1fr; }
    .contact-photo { grid-column: 1 / -1; max-width: 340px; }
  }
  @media (max-width: 700px) {
    .contact-body { grid-template-columns: 1fr; }
  }
</style>
