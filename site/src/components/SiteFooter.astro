---
import nav from '../data/nav.json';
import site from '../data/site.json';

const follow = [
  {
    href: 'https://www.instagram.com/harveylewisultrarunner',
    name: 'Instagram',
    handle: '@harveylewisultrarunner',
    svg: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line></svg>`,
  },
  {
    href: 'https://www.facebook.com/harveylewisultrarunner',
    name: 'Facebook',
    handle: '@harveylewisultrarunner',
    svg: `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"></path></svg>`,
  },
  {
    href: 'https://twitter.com/harveylewisruns',
    name: 'X (Twitter)',
    handle: '@harveylewisruns',
    svg: `<svg width="19" height="19" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 22.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"></path></svg>`,
  },
  {
    href: 'https://www.youtube.com/@HarveyandKelly',
    name: 'YouTube',
    handle: 'Harvey and Kelly',
    svg: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22.54 6.42a2.78 2.78 0 0 0-1.94-2C18.88 4 12 4 12 4s-6.88 0-8.6.46a2.78 2.78 0 0 0-1.94 2A29 29 0 0 0 1 11.75a29 29 0 0 0 .46 5.33A2.78 2.78 0 0 0 3.4 19c1.72.46 8.6.46 8.6.46s6.88 0 8.6-.46a2.78 2.78 0 0 0 1.94-2 29 29 0 0 0 .46-5.25 29 29 0 0 0-.46-5.33z"></path><polygon points="9.75 15.02 15.5 11.75 9.75 8.48 9.75 15.02" fill="currentColor"></polygon></svg>`,
  },
];

const elsewhere = [
  { href: 'https://www.runquesttravel.com', label: 'RunQuest Travel' },
  { href: 'https://www.likeharveylikeson.com', label: 'Like Harvey Like Son — the film' },
];
---

<footer class="site-footer">
  <div class="footer-grid">
    <div>
      <p class="wordmark">Harvey Lewis</p>
      <p class="footer-tag">Teacher. Ultrarunner. Cincinnati, Ohio.</p>
    </div>

    <div>
      <p class="col-label">Pages</p>
      <ul>
        {nav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
        <li><a href="/contact">Contact</a></li>
      </ul>
    </div>

    <div>
      <p class="col-label">Follow</p>
      <div class="social-icons">
        {
          follow.map((item) => (
            <a
              href={item.href}
              target="_blank"
              rel="noopener noreferrer"
              class="social-icon-btn"
              aria-label={`Follow Harvey Lewis on ${item.name} (${item.handle})`}
              title={`${item.name} — ${item.handle}`}
            >
              <Fragment set:html={item.svg} />
            </a>
          ))
        }
      </div>
    </div>

    <div>
      <p class="col-label">Elsewhere</p>
      <ul>
        {elsewhere.map((item) => <li><a href={item.href} target="_blank" rel="noopener noreferrer">{item.label}</a></li>)}
      </ul>
    </div>
  </div>

  <div class="footer-base">
    <span>Harvey Lewis · Cincinnati, Ohio</span>
    {
      site.enquiryEmailIsPlaceholder && (
        <span class="warning">Placeholder address on all enquiry links — replace before launch</span>
      )
    }
    <span>Photography: Mike Trimpe &amp; others</span>
    <a href="#top" class="top-link">Top ↑</a>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--line);
    background: var(--bg-deep);
  }

  .footer-grid {
    max-width: var(--max-w);
    margin: 0 auto;
    padding: 56px var(--pad-x) 40px;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 40px;
  }

  .wordmark {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink);
  }

  .footer-tag {
    color: var(--ink-dim);
    font-size: 14px;
    margin-top: 10px;
  }

  .col-label {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgba(237, 228, 211, 0.62);
  }

  ul {
    list-style: none;
    margin-top: 14px;
    display: grid;
    gap: 8px;
  }

  ul a {
    font-size: 14px;
    color: var(--ink-dim);
    transition: color 0.15s ease;
  }

  ul a:hover {
    color: var(--rust);
  }

  .social-icons {
    margin-top: 14px;
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
  }

  .social-icon-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border: 1px solid var(--line);
    color: var(--ink-dim);
    transition: color 0.16s ease, border-color 0.16s ease, background-color 0.16s ease, transform 0.16s ease;
  }

  .social-icon-btn:hover {
    color: var(--rust);
    border-color: var(--rust);
    background: rgba(232, 81, 31, 0.08);
    transform: translateY(-2px);
  }

  .social-icon-btn:focus-visible {
    outline: 2px solid var(--rust);
    outline-offset: 2px;
  }

  .social-icon-btn:active {
    transform: scale(0.96);
  }

  .footer-base {
    max-width: var(--max-w);
    margin: 0 auto;
    border-top: 1px solid var(--line);
    padding: 24px var(--pad-x) 32px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    flex-wrap: wrap;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(237, 228, 211, 0.62);
  }

  .warning {
    color: var(--rust);
  }

  .top-link {
    transition: color 0.15s ease;
  }

  .top-link:hover {
    color: var(--ink);
  }
</style>
