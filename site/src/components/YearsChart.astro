---
import races from '../data/races.json';
import { raceId, raceKind, raceLabel } from '../lib/races';

interface Props {
  /** On /races each mark jumps to its row in the archive below. */
  linked?: boolean;
}
const { linked = false } = Astro.props;

const firstYear = Math.min(...races.map((r) => r.year));
const lastYear = Math.max(...races.map((r) => r.year));
const years = Array.from({ length: lastYear - firstYear + 1 }, (_, i) => firstYear + i).map((year) => ({
  year,
  races: races.filter((r) => r.year === year).sort((a, b) => a.date.localeCompare(b.date)),
}));
const tallest = Math.max(...years.map((y) => y.races.length));
const gapStart = 2000 - firstYear;
// Label every fifth year, plus the ends when they have room to breathe.
const showYear = (y: number) =>
  y % 5 === 0 || (y === firstYear && y % 5 < 3) || (y === lastYear && y % 5 >= 3);
const cols = years.length;
---

<div class="chart" style={`--rows:${tallest}; --cols:${cols}; --gap-start:${gapStart}`} data-chart>
  <div class="chart-gap" aria-hidden="true">
    <p>
      No results, 2000–2005. A broken neck, around 2004.
      <span>“After that event I actually have become so much faster.” WVXU, 2014</span>
    </p>
  </div>
  <ol class="chart-cols" aria-hidden="true">
    {
      years.map((y) => (
        <li class="col">
          <span class="col-marks">
            {y.races.map((r) =>
              linked ? (
                <a href={`#${raceId(r)}`} tabindex="-1" class={`m m-${raceKind(r)}`} data-label={`${r.year} · ${raceLabel(r)}`} />
              ) : (
                <span class={`m m-${raceKind(r)}`} data-label={`${r.year} · ${raceLabel(r)}`} />
              ),
            )}
          </span>
          <span class="col-year">{showYear(y.year) ? y.year : ''}</span>
        </li>
      ))
    }
  </ol>
  <p class="chart-read" aria-live="polite" data-read>
    {linked ? 'Point at a mark to read the race. Click to jump to it.' : 'Point at a mark to read the race.'}
  </p>
  <ul class="chart-key" aria-hidden="true">
    <li><span class="m m-win"></span>Win</li>
    <li><span class="m m-podium"></span>Podium</li>
    <li><span class="m m-finish"></span>Finish</li>
    <li><span class="m m-dnf"></span>Did not finish</li>
  </ul>
</div>

<script>
  // Pointing at a mark reads the race in the caption line.
  document.querySelectorAll<HTMLElement>('[data-chart]').forEach((chart) => {
    const read = chart.querySelector('[data-read]');
    if (!read) return;
    const idle = read.textContent;
    const clear = () => chart.querySelectorAll('.is-hot').forEach((x) => x.classList.remove('is-hot'));
    chart.addEventListener('pointerover', (e) => {
      const m = (e.target as HTMLElement).closest<HTMLElement>('[data-label]');
      if (!m) return;
      clear();
      m.classList.add('is-hot');
      read.textContent = m.dataset.label ?? '';
    });
    chart.addEventListener('pointerleave', () => {
      clear();
      read.textContent = idle;
    });
  });
</script>

<style is:global>
  .chart { position: relative; }
  .chart-cols {
    display: grid;
    grid-template-columns: repeat(var(--cols), minmax(0, 1fr));
    gap: 0 clamp(3px, 0.5vw, 8px);
    border-bottom: 2px solid var(--ink);
  }
  .col { position: relative; }
  .col-marks {
    display: flex; flex-direction: column-reverse; gap: clamp(3px, 0.4vw, 6px);
    min-height: calc(var(--rows) * (clamp(10px, 1.5vw, 22px) + clamp(3px, 0.4vw, 6px)));
    padding-bottom: clamp(3px, 0.4vw, 6px);
  }
  .col-year {
    position: absolute; top: 100%; left: 0; margin-top: 10px;
    font-family: var(--display); font-weight: 650; font-size: 15px; letter-spacing: 0.04em;
    color: var(--ink-dim); font-variant-numeric: tabular-nums;
  }
  .m {
    display: block; width: 100%; height: clamp(10px, 1.5vw, 22px);
    transition: transform 0.2s var(--ease), background-color 0.2s;
  }
  .m-win { background: var(--line); }
  .m-podium { background: var(--ink); }
  .m-finish { box-shadow: inset 0 0 0 1.5px var(--ink-dim); }
  .m-dnf { background: repeating-linear-gradient(135deg, var(--ink-faint) 0 1.5px, transparent 1.5px 5px); }
  .m.is-hot { transform: scaleX(1.35); background-color: var(--ink); box-shadow: none; }
  .chart-gap {
    position: absolute; top: 0; bottom: 0;
    left: calc(var(--gap-start) / var(--cols) * 100%); width: calc(6 / var(--cols) * 100%);
    display: flex; align-items: flex-start; padding-top: 4px;
    border-left: 1px dashed var(--rule); border-right: 1px dashed var(--rule);
  }
  .chart-gap p { padding: 0 12px; font-size: 15px; line-height: 1.35; max-width: 20ch; text-wrap: pretty; }
  .chart-gap span { display: block; margin-top: 8px; color: var(--ink-faint); }
  .chart-read {
    margin-top: 56px; min-height: 1.5em;
    font-family: var(--display); font-weight: 650; font-size: 19px;
    letter-spacing: 0.04em; text-transform: uppercase;
  }
  .chart-key {
    display: flex; flex-wrap: wrap; gap: 8px 28px; margin-top: 16px;
    font-family: var(--display); font-weight: 600; font-size: 15px;
    letter-spacing: 0.06em; text-transform: uppercase; color: var(--ink-dim);
  }
  .chart-key li { display: flex; align-items: center; gap: 10px; }
  .chart-key .m { width: 22px; height: 12px; }
  @media (max-width: 900px) {
    .chart-gap { display: none; }
    .col-year { font-size: 12px; }
  }
</style>
