---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Arrow from '../components/Arrow.astro';
import site from '../data/site.json';
import mediaKit from '../data/media-kit.json';
import reach from '../data/reach.json';
import poster from '../assets/photos/architects-of-destiny.jpg';

const mediaHref = `mailto:${site.enquiryEmail}?subject=${encodeURIComponent('Media enquiry')}`;
const kitHref = `mailto:${site.enquiryEmail}?subject=${encodeURIComponent('Media kit request')}`;

const videos = [
  {
    title: 'Rich Roll Podcast · Ep. 812',
    sub: '"The 47-Year-Old High School Teacher Who Ran 450 Miles and Broke a World Record" · Feb 2024',
