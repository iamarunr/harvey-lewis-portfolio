  },
  {
    year: '2023',
    outlet: 'iRunFar',
    title: 'A Different Mode: An Interview with Harvey Lewis After His Record-Breaking Win at the 2023 Big Dog\'s Backyard Ultra',
    note: 'Full Q&A after the 450-mile world record on sleep strategy, vegan fueling, and future goals.',
    byline: 'Sarah Brady · Nov 10, 2023',
    url: 'https://www.irunfar.com/harvey-lewis-2023-big-dogs-backyard-ultra-interview',
  },
  {
    year: '2023',
    outlet: 'iRunFar',
    title: '2023 Big Dog\'s Backyard Ultra Results: Harvey Lewis Wins After 108 Hours, 450 Miles of Running',
    note: 'The race report on six runners past 100 hours, and one left standing.',
    byline: 'Sarah Brady · Oct 25, 2023',
    url: 'https://www.irunfar.com/2023-big-dogs-backyard-ultra-results',
  },
  {
    year: '2023',
    outlet: 'Miriam Diaz Gilbert',
    title: 'Harvey Lewis on Training, Racing, Crewing, Diet, Gardening, and His Documentary',
    note: 'Long-form interview while packing for Australia on crew philosophy and life beyond racing.',
    byline: 'June 2023',
    url: 'https://www.miriamdiazgilbert.com/post/harvey-lewis-on-racing-his-plant-based-diet-gardening-and-his-documentary-like-harvey-like-son',
  },
  {
    year: '2021',
    outlet: 'iRunFar',
    title: 'Harvey Lewis is the Last Person Standing at the 2021 Big Dog\'s Backyard Ultra',
    note: '85 laps, 354 miles: a new world record in Bell Buckle, Tennessee.',
    byline: 'Alex Potter · Oct 19, 2021',
    url: 'https://www.irunfar.com/harvey-lewis-is-the-last-person-standing-at-the-2021-big-dogs-backyard-ultra',
  },
  {
    year: '2021',
    outlet: 'Trail Running Magazine',
