  },
  {
    title: 'Top Mindsets Every Ultrarunner Needs',
    sub: 'Short · May 2025',
    url: 'https://www.youtube.com/shorts/-BitmQ2dL7U',
  },
];

const podcasts = [
  {
    show: 'Ageless Athlete Podcast',
    ep: 'How Harvey Lewis Healed After the World’s Wildest Ultra',
    date: 'Jan 2026',
    url: 'https://www.youtube.com/watch?v=s9z8rK0u7yA',
  },
  {
    show: 'Rich Roll Podcast',
    ep: 'Ep. 812: The 47-Year-Old High School Teacher Who Ran 450 Miles',
    date: 'Feb 2024',
    url: 'https://richroll.com/podcast/harvey-lewis-812/',
  },
  {
    show: 'Ultra Running Magazine Podcast',
    ep: 'Pre-WS100 with Harvey Lewis: Big’s Record & Western States',
    date: 'Jun 2024',
    url: 'https://ultrarunningmagazine.libsyn.com/',
  },
  {
    show: 'Rich Roll Podcast',
    ep: 'Ep. 658: Finding Your Why, Nirvana Moments & Winning 300+ Mile Races',
    date: 'Jan 2022',
    url: 'https://www.richroll.com/podcast/harvey-lewis-658/',
  },
  {
    show: 'The Extra Mile (Charity Miles)',
    ep: 'Nice Guys Finish Last: the host joins Harvey\'s run-commute',
    date: '2024',
    url: 'https://podcasts.apple.com/us/podcast/the-extra-mile-the-official-charity-miles-podcast/id1256271696?i=1000673075256',
  },
  {
    show: 'Marathon Training Academy',
    ep: '354 Miles in 85 Hours: the Honey Badger race',
    date: 'Nov 2021',
    url: 'https://www.marathontrainingacademy.com/harvey-lewis',
  },
  {
    show: 'No Meat Athlete Radio',
    ep: 'Ep. 37: Badwater Winner and Vegetarian Harvey Lewis',
    date: '2014',
    url: 'https://www.nomeatathlete.com/podcast/radio-37/',
  },
];

const articles = [
  {
    year: '2026',
    outlet: 'Chasing Democracy 250',
    title: 'A Run For The Stories That Keep Us Moving: Four Runners Complete 250 Miles from NYC to DC',
    note: 'Feature coverage of the 5-day, 250-mile journey from Liberty State Park to the MLK Jr. Memorial celebrating America’s 250th anniversary.',
    byline: 'July 2026',
    url: 'https://chasingdemocracy250.com/',
  },
  {
    year: '2026',
    outlet: 'Badwater 135',
    title: 'Harvey Lewis Logs 15th Career Badwater Finish at Age 50',
    note: 'Crossing the Mt. Whitney Portal in 25:55:41 for his 15th official finish of "the world’s toughest footrace."',
    byline: 'July 2026',
    url: 'https://www.badwater.com/',
  },
  {
    year: '2024',
    outlet: 'Newton Running / Trail Media',
    title: 'Harvey Lewis Pulls Off the "Badwater Double": 270 Miles Across Death Valley and Back',
