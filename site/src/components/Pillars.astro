---
import pillars from '../data/pillars.json';
import Quote from './Quote.astro';
---

<section id="story">
  <div class="section-inner">
    <div class="pillars-head" data-reveal>Four pillars, one runner</div>

    <div class="pillars hairline-grid" data-reveal-group data-reveal-step="110">
      {
        pillars.map((pillar) => (
          <div class="pillar lift" data-reveal>
            <div class="pillar-figure" data-count>{pillar.figure}</div>
            <div class="pillar-title">{pillar.title}</div>
            <p>{pillar.body}</p>
          </div>
        ))
      }
    </div>

    <Quote />
  </div>
</section>

<style>
  .pillars-head {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: rgba(237, 228, 211, 0.65);
    border-bottom: 1px solid rgba(237, 228, 211, 0.16);
    padding-bottom: 14px;
  }

  .pillars {
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    margin-top: 34px;
  }

  .pillar {
    background: var(--bg);
    padding: 30px 26px;
  }

  .pillar-figure {
    font-family: var(--font-num);
    font-size: 40px;
    line-height: 1;
    color: var(--rust);
  }

  .pillar-title {
    font-weight: 600;
    font-size: 20px;
    line-height: 1.25;
    margin-top: 14px;
  }

  .pillar p {
    margin-top: 12px;
    font-size: 15px;
    line-height: 1.66;
    color: rgba(237, 228, 211, 0.78);
    text-wrap: pretty;
  }
</style>
