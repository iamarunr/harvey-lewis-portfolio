---
import { Image } from 'astro:assets';
import SiteHeader from './SiteHeader.astro';
import races from '../data/races.json';
import heroImage from '../assets/photos/hero-silhouette.jpg';

// Race count and first year come from the data so the rail can't drift as results land.
const raceCount = races.length;
const firstYear = Math.min(...races.map((race) => race.year));

const facts = [
  { figure: '30', label: 'Years of ultrarunning' },
  { figure: '15×', label: 'Badwater finishes (2× win)' },
  { figure: '5×', label: 'Team USA appearances' },
  { figure: String(raceCount), label: `Races since ${firstYear}` },
];
---

<section id="top" class="hero">
  <div class="hero-photo-wrap">
    <Image
      src={heroImage}
      alt="Harvey Lewis running in silhouette at dusk"
      class="hero-photo"
      widths={[900, 1440, 2000, 2736]}
      sizes="(max-width: 860px) 100vw, 58vw"
      loading="eager"
      fetchpriority="high"
    />
  </div>

  <SiteHeader variant="overlay" />

  <div class="hero-center">
    <div class="hero-content" data-reveal-group data-reveal-step="110">
      <div class="eyebrow eyebrow-rust hero-eyebrow" data-reveal>
        Cincinnati, Ohio — ultrarunner &amp; high school teacher
      </div>
      <h1 data-reveal>The limits we believe in are the only ones that exist.</h1>
      <p class="hero-body" data-reveal>
        Two-time Badwater 135 champion, five-time Team USA runner, and Cincinnati teacher.
        Thirty years of exploring human resilience on foot.
      </p>
      <div class="cta-row desktop-cta" data-reveal>
        <a href="/contact" class="btn btn-solid">Sponsorship &amp; speaking →</a>
        <a href="/media" class="btn btn-outline hero-secondary">Media kit <span class="cta-arrow" aria-hidden="true">→</span></a>
      </div>
    </div>
  </div>

  <a href="#intro" class="scroll-cue" aria-label="Scroll to content">
    <span></span>
  </a>

  <div class="hero-bottom">
    <div class="fact-rail" data-reveal-group data-reveal-step="90">
      {
        facts.map((fact) => (
          <div data-reveal>
            <div class="figure" data-count>{fact.figure}</div>
            <div class="fact-label">{fact.label}</div>
          </div>
        ))
      }
    </div>
    <div class="mobile-cta" data-reveal>
      <a href="/contact" class="btn btn-solid">Sponsorship &amp; speaking →</a>
      <a href="/media" class="btn btn-outline hero-secondary">Media kit <span class="cta-arrow" aria-hidden="true">→</span></a>
    </div>
  </div>
</section>

<style>
  /* grid-template-columns: minmax(0, 1fr) prevents rail min-content overflow */
  .hero {
    position: relative;
    min-height: 100vh;
    min-height: 100svh;
    overflow: hidden;
    display: grid;
    grid-template-rows: auto 1fr auto;
    grid-template-columns: minmax(0, 1fr);
    background: var(--bg);
  }

  .hero-photo-wrap {
    position: absolute;
    top: 0;
    bottom: 0;
    right: 0;
    width: clamp(50vw, 56vw, 980px);
    height: 100%;
    overflow: hidden;
    pointer-events: none;
    mask-image: linear-gradient(to right, transparent 0%, rgba(0, 0, 0, 0.7) 18%, black 36%);
    -webkit-mask-image: linear-gradient(to right, transparent 0%, rgba(0, 0, 0, 0.7) 18%, black 36%);
  }

  .hero-photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 46% 40%;
    animation: hero-settle 1.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  @keyframes hero-settle {
    0% {
      transform: scale(1.04);
    }
    100% {
      transform: scale(1);
    }
  }

  .hero-center {
    position: relative;
    align-self: center;
    width: 100%;
    max-width: var(--max-w);
    margin: 0 auto;
    padding: clamp(24px, 4vw, 48px) var(--pad-x);
    z-index: 2;
  }

  .hero-content {
    max-width: clamp(600px, 50vw, 860px);
  }

  .hero-eyebrow {
    letter-spacing: 0.2em;
  }

  .hero-center h1 {
    margin-top: 24px;
    font-weight: 600;
    font-size: clamp(38px, 4.8vw, 80px);
    line-height: 1.04;
    letter-spacing: -0.025em;
    max-width: 18ch;
  }

  .hero-body {
    margin-top: 28px;
    max-width: 48ch;
    font-size: clamp(18px, 1.2vw, 22px);
    line-height: 1.62;
    color: var(--ink-subtle);
    text-wrap: pretty;
  }

  .hero-bottom {
    position: relative;
    padding: 0 var(--pad-x) clamp(24px, 3.5vw, 44px);
    z-index: 2;
  }

  /* Minimalist loop pacer scroll cue */
  .scroll-cue {
    position: absolute;
    left: 50%;
    bottom: clamp(110px, 12vh, 140px);
    translate: -50%;
    z-index: 3;
    width: 24px;
    height: 42px;
    border: 1px solid var(--line-strong);
    display: flex;
    justify-content: center;
    transition: border-color 0.2s ease;
  }

  .scroll-cue:hover,
  .scroll-cue:focus-visible {
    border-color: var(--rust);
  }

  .scroll-cue span {
    position: absolute;
    top: 6px;
    width: 2px;
    height: 7px;
    background: var(--rust);
    animation: scroll-dot 2.2s cubic-bezier(0.65, 0, 0.35, 1) infinite;
  }

  @keyframes scroll-dot {
    0% {
      transform: translateY(0);
      opacity: 0;
    }
    30% {
      opacity: 1;
    }
    70% {
      transform: translateY(18px);
      opacity: 0.9;
    }
    100% {
      transform: translateY(22px);
      opacity: 0;
    }
  }

  .fact-rail {
    max-width: var(--max-w);
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 24px clamp(24px, 4vw, 56px);
    padding-top: 28px;
    position: relative;
  }

  .fact-rail::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: var(--line-strong);
    transform-origin: left;
    animation: rail-draw 1.1s cubic-bezier(0.16, 1, 0.3, 1) 0.3s backwards;
  }

  @keyframes rail-draw {
    0% {
      transform: scaleX(0);
      opacity: 0;
    }
    100% {
      transform: scaleX(1);
      opacity: 1;
    }
  }

  .fact-label {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-dim);
    margin-top: 8px;
  }

  .mobile-cta {
    display: none;
  }

  /* ---- phone ----
     Stacked editorial mobile presentation:
     - The runner photo sits prominently at the top, unobstructed and crystal clear.
     - Headline, bio, and figures sit cleanly on solid dark background below.
     - Buttons are pushed to the bottom of the section below the stats. */
  @media (max-width: 860px) {
    .hero {
      display: flex;
      flex-direction: column;
      min-height: auto;
      background: var(--bg);
    }

    .hero-photo-wrap {
      order: 2;
      position: relative;
      top: auto;
      right: auto;
      bottom: auto;
      width: 100%;
      height: clamp(260px, 35vh, 340px);
      overflow: hidden;
      mask-image: linear-gradient(to bottom, black 80%, transparent 100%);
      -webkit-mask-image: linear-gradient(to bottom, black 80%, transparent 100%);
    }

    .hero-photo-wrap::after {
      display: none;
    }

    .hero-photo {
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: 48% 20%;
    }

    .hero-center {
      order: 3;
      padding: 24px var(--pad-x) 16px;
    }

    .hero-content {
      max-width: 100%;
    }

    .hero-eyebrow {
      color: var(--ink-dim);
      font-size: 11px;
      letter-spacing: 0.16em;
    }

    .hero-center h1 {
      margin-top: 14px;
      font-size: clamp(28px, 7.5vw, 38px);
      line-height: 1.1;
      letter-spacing: -0.02em;
      max-width: 100%;
    }

    .hero-body {
      margin-top: 14px;
      font-size: 15px;
      line-height: 1.6;
      color: var(--ink-subtle);
      max-width: 42ch;
    }

    .desktop-cta {
      display: none;
    }

    .scroll-cue {
      display: none;
    }

    .hero-bottom {
      order: 4;
      padding: 12px var(--pad-x) clamp(32px, 5vh, 48px);
    }

    .fact-rail {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 16px 20px;
      padding-top: 16px;
    }

    .fact-rail :global(.figure) {
      font-size: 28px;
    }

    .fact-label {
      font-size: 10.5px;
      letter-spacing: 0.1em;
      margin-top: 4px;
      color: var(--ink-dim);
    }

    /* Buttons pushed cleanly to the bottom */
    .mobile-cta {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: 12px;
      margin-top: 28px;
    }

    .mobile-cta .btn-solid {
      width: 100%;
      text-align: center;
      padding: 16px 20px;
    }

    .mobile-cta .hero-secondary {
      border: 0;
      background: transparent;
      padding: 6px 0;
      min-height: 40px;
      font-family: var(--font-mono);
      font-size: 12px;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--ink-dim);
      display: inline-flex;
      align-items: center;
      gap: 6px;
      text-decoration: underline;
      text-underline-offset: 4px;
      text-decoration-color: var(--line-strong);
      transition: color 0.15s ease, text-decoration-color 0.15s ease;
    }

    .mobile-cta .hero-secondary:hover {
      color: var(--ink);
      text-decoration-color: var(--rust);
    }
  }

  /* Small phones */
  @media (max-width: 380px) {
    .hero-photo-wrap {
      height: 240px;
    }

    .hero-center h1 {
      font-size: 27px;
    }

    .hero-body {
      font-size: 14px;
      margin-top: 12px;
    }

    .fact-rail :global(.figure) {
      font-size: 24px;
    }
  }
</style>
