---
import { Image } from 'astro:assets';
import SiteHeader from './SiteHeader.astro';
import races from '../data/races.json';
import heroImage from '../assets/photos/hero-silhouette.jpg';

// Race count and first year come from the data so the rail can't drift as results land.
const raceCount = races.length;
const firstYear = Math.min(...races.map((race) => race.year));

const facts = [
  { figure: '30', label: 'Years of ultrarunning' },
  { figure: '15×', label: 'Badwater finishes (2× win)' },
  { figure: '5×', label: 'Team USA appearances' },
  { figure: String(raceCount), label: `Races since ${firstYear}` },
];
---

<section id="top" class="hero">
  <div class="hero-photo-wrap">
    <Image
      src={heroImage}
      alt="Harvey Lewis running in silhouette at dusk"
      class="hero-photo"
      widths={[900, 1440, 2000, 2736]}
      sizes="(max-width: 860px) 100vw, 58vw"
      loading="eager"
      fetchpriority="high"
    />
  </div>

  <SiteHeader variant="overlay" />

  <div class="hero-center">
    <div class="hero-content" data-reveal-group data-reveal-step="110">
      <div class="eyebrow eyebrow-rust hero-eyebrow" data-reveal>
        Cincinnati, Ohio — ultrarunner &amp; high school teacher
      </div>
      <h1 data-reveal>The limits we believe in are the only ones that exist.</h1>
      <p class="hero-body" data-reveal>
        Two-time Badwater 135 champion, five-time Team USA runner, and Cincinnati teacher.
        Thirty years of exploring human resilience on foot.
      </p>
      <div class="cta-row" data-reveal>
        <a href="/contact" class="btn btn-solid">Sponsorship &amp; speaking →</a>
        <a href="/media" class="btn btn-outline">Media kit</a>
      </div>
    </div>
  </div>

  <a href="#intro" class="scroll-cue" aria-label="Scroll to content">
    <span></span>
  </a>

  <div class="hero-bottom">
    <div class="fact-rail" data-reveal-group data-reveal-step="90">
      {
        facts.map((fact) => (
          <div data-reveal>
            <div class="figure" data-count>{fact.figure}</div>
            <div class="fact-label">{fact.label}</div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  /* grid-template-columns: minmax(0, 1fr) prevents rail min-content overflow */
  .hero {
    position: relative;
    min-height: 100vh;
    min-height: 100svh;
    overflow: hidden;
    display: grid;
    grid-template-rows: auto 1fr auto;
    grid-template-columns: minmax(0, 1fr);
    background: var(--bg);
  }

  .hero-photo-wrap {
    position: absolute;
    top: 0;
    bottom: 0;
    right: 0;
    width: clamp(50vw, 56vw, 980px);
    height: 100%;
    overflow: hidden;
    pointer-events: none;
    mask-image: linear-gradient(to right, transparent 0%, rgba(0, 0, 0, 0.7) 18%, black 36%);
    -webkit-mask-image: linear-gradient(to right, transparent 0%, rgba(0, 0, 0, 0.7) 18%, black 36%);
  }

  .hero-photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 46% 40%;
    animation: hero-settle 1.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  @keyframes hero-settle {
    0% {
      transform: scale(1.04);
    }
    100% {
      transform: scale(1);
    }
  }

  .hero-center {
    position: relative;
    align-self: center;
    width: 100%;
    max-width: var(--max-w);
    margin: 0 auto;
    padding: clamp(24px, 4vw, 48px) var(--pad-x);
    z-index: 2;
  }

  .hero-content {
    max-width: clamp(600px, 50vw, 860px);
  }

  .hero-eyebrow {
    letter-spacing: 0.2em;
  }

  .hero-center h1 {
    margin-top: 24px;
    font-weight: 600;
    font-size: clamp(38px, 4.8vw, 80px);
    line-height: 1.04;
    letter-spacing: -0.025em;
    max-width: 18ch;
  }

  .hero-body {
    margin-top: 28px;
    max-width: 48ch;
    font-size: clamp(18px, 1.2vw, 22px);
    line-height: 1.62;
    color: var(--ink-subtle);
    text-wrap: pretty;
  }

  .hero-bottom {
    position: relative;
    padding: 0 var(--pad-x) clamp(24px, 3.5vw, 44px);
    z-index: 2;
  }

  /* Minimalist loop pacer scroll cue */
  .scroll-cue {
    position: absolute;
    left: 50%;
    bottom: clamp(110px, 12vh, 140px);
    translate: -50%;
    z-index: 3;
    width: 24px;
    height: 42px;
    border: 1px solid var(--line-strong);
    display: flex;
    justify-content: center;
    transition: border-color 0.2s ease;
  }

  .scroll-cue:hover,
  .scroll-cue:focus-visible {
    border-color: var(--rust);
  }

  .scroll-cue span {
    position: absolute;
    top: 6px;
    width: 2px;
    height: 7px;
    background: var(--rust);
    animation: scroll-dot 2.2s cubic-bezier(0.65, 0, 0.35, 1) infinite;
  }

  @keyframes scroll-dot {
    0% {
      transform: translateY(0);
      opacity: 0;
    }
    30% {
      opacity: 1;
    }
    70% {
      transform: translateY(18px);
      opacity: 0.9;
    }
    100% {
      transform: translateY(22px);
      opacity: 0;
    }
  }

  .fact-rail {
    max-width: var(--max-w);
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 24px clamp(24px, 4vw, 56px);
    padding-top: 28px;
    position: relative;
  }

  .fact-rail::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: var(--line-strong);
    transform-origin: left;
    animation: rail-draw 1.1s cubic-bezier(0.16, 1, 0.3, 1) 0.3s backwards;
  }

  @keyframes rail-draw {
    0% {
      transform: scaleX(0);
      opacity: 0;
    }
    100% {
      transform: scaleX(1);
      opacity: 1;
    }
  }

  .fact-label {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-dim);
    margin-top: 8px;
  }
  /* ---- phone ----
     The photo goes behind the copy rather than above it. Stacking it pushed the
     headline to the bottom edge and both CTAs off-screen: the hero ran 1585px on a
     812px viewport, so the first screen showed a menu and a picture and nothing to
     act on. Behind the copy, the whole proposition fits one screen. */
  @media (max-width: 860px) {
    .hero {
      grid-template-rows: auto 1fr auto;
      gap: 0;
      min-height: 100svh;
    }

    .hero-photo-wrap {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      /* Full-bleed behind the text, so no side mask. */
      mask-image: none;
      -webkit-mask-image: none;
    }

    /* Flat scrim — the type has to clear the photo at AA. */
    .hero-photo-wrap::after {
      content: '';
      position: absolute;
      inset: 0;
      background: var(--scrim-hero);
    }

    .hero-photo {
      object-position: 62% 22%;
    }

    .hero-center {
      padding: 20px var(--pad-x);
    }

    .hero-content {
      max-width: 100%;
    }

    .hero-center h1 {
      margin-top: 16px;
      font-size: clamp(30px, 8.2vw, 42px);
      line-height: 1.08;
      letter-spacing: -0.02em;
      max-width: 100%;
    }

    .hero-body {
      margin-top: 16px;
      font-size: 16px;
      line-height: 1.55;
      max-width: 42ch;
    }

    /* Full-width stacked buttons — comfortable thumb targets, predictable height. */
    .hero-center :global(.cta-row) {
      margin-top: 24px;
      flex-direction: column;
      align-items: stretch;
      gap: 10px;
    }

    .hero-center :global(.cta-row .btn) {
      text-align: center;
      padding: 15px 20px;
    }

    .scroll-cue {
      display: none;
    }

    .hero-bottom {
      padding-bottom: 22px;
    }

    /* Two-up so the four figures cost four rows' height, not eight. */
    .fact-rail {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 16px 20px;
      padding-top: 18px;
    }

    .fact-rail :global(.figure) {
      font-size: 30px;
    }

    .fact-label {
      font-size: 10.5px;
      letter-spacing: 0.1em;
      margin-top: 4px;
    }
  }

  /* Small phones: trim the last few pixels so the rail stays on the first screen. */
  @media (max-width: 380px) {
    .hero-center h1 {
      font-size: 29px;
    }

    .hero-body {
      font-size: 15px;
      margin-top: 14px;
    }

    .fact-rail :global(.figure) {
      font-size: 26px;
    }
  }
</style>
