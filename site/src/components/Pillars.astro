---
import pillars from '../data/pillars.json';
import Quote from './Quote.astro';
---

<section id="story">
  <div class="section-inner">
    <h2 class="pillars-head" data-reveal>Four pillars, one runner</h2>

    <div class="pillars hairline-grid" data-reveal-group data-reveal-step="110">
      {
        pillars.map((pillar) => (
          <div class="pillar lift" data-reveal>
            <div class="pillar-figure" data-count>{pillar.figure}</div>
            <h3 class="pillar-title">{pillar.title}</h3>
            <p>{pillar.body}</p>
          </div>
        ))
      }
    </div>

    <Quote />

    <a href="/story" class="see-all" data-reveal>Explore Harvey’s full story &amp; biography →</a>
  </div>
</section>

<style>
  .pillars-head {
    font-family: var(--font-mono);
    font-size: clamp(12px, 0.85vw, 13px);
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ink-dim);
    border-bottom: 1px solid var(--line-strong);
    padding-bottom: 16px;
    margin: 0;
  }

  .pillars {
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr));
    margin-top: 40px;
  }

  .pillar {
    background: var(--bg);
    padding: clamp(32px, 3vw, 44px) clamp(26px, 2.5vw, 36px);
    display: flex;
    flex-direction: column;
    min-height: 260px;
  }

  .pillar-figure {
    font-family: var(--font-num);
    font-size: clamp(46px, 4.5vw, 70px);
    line-height: 1;
    color: var(--rust);
    font-variant-numeric: tabular-nums;
  }

  .pillar-title {
    font-weight: 600;
    font-size: clamp(22px, 1.6vw, 27px);
    line-height: 1.22;
    margin-top: 18px;
  }

  .pillar p {
    margin-top: 12px;
    font-size: clamp(16px, 1.05vw, 18px);
    line-height: 1.62;
    color: var(--ink-dim);
    text-wrap: pretty;
  }
</style>
