---
import { Image } from 'astro:assets';
import '@fontsource-variable/big-shoulders/opsz.css';
import '@fontsource-variable/source-serif-4/opsz.css';
import Meta from '../components/Meta.astro';
import races from '../data/races.json';
import site from '../data/site.json';

import nightRun from '../assets/long-way/night-run.jpg';
import students from '../assets/long-way/students.jpg';
import badwaterFinish from '../assets/long-way/badwater-finish.jpg';
import backyardFlags from '../assets/long-way/backyard-flags.jpg';
import saltFlat from '../assets/long-way/salt-flat.jpg';
import stovepipe24 from '../assets/long-way/stovepipe-24.jpg';
import stovepipe29 from '../assets/long-way/stovepipe-29.jpg';
import stovepipe33 from '../assets/long-way/stovepipe-33.jpg';
import keeler from '../assets/long-way/keeler.jpg';
import switchback from '../assets/long-way/switchback.jpg';

const title = 'Harvey Lewis — ultrarunner & high school teacher';
const description =
  'Two-time Badwater 135 champion, twice a backyard ultra world record setter, and a high school teacher in Cincinnati, Ohio.';

/* ---------- Career numbers, all derived from races.json ---------- */
const finished = races.filter((r) => r.status === 'finished');
const wins = finished.filter((r) => r.placeOverall === 1).length;
const firstYear = Math.min(...races.map((r) => r.year));
const lastYear = Math.max(...races.map((r) => r.year));

type Kind = 'win' | 'podium' | 'finish' | 'dnf';
const kindOf = (r: (typeof races)[number]): Kind =>
  r.status !== 'finished' ? 'dnf' : r.placeOverall === 1 ? 'win' : r.placeOverall <= 3 ? 'podium' : 'finish';
const ordinal = (n: number) => {
  const s = ['th', 'st', 'nd', 'rd'];
  const v = n % 100;
  return n + (s[(v - 20) % 10] || s[v] || s[0]);
};

const years = Array.from({ length: lastYear - firstYear + 1 }, (_, i) => firstYear + i).map((year) => ({
  year,
  races: races
    .filter((r) => r.year === year)
    .sort((a, b) => a.date.localeCompare(b.date))
    .map((r) => ({
      kind: kindOf(r),
      label: `${r.race.split(' - ')[0]} · ${r.status === 'dnf' ? 'DNF' : `${r.result} · ${ordinal(r.placeOverall)}`}`,
      date: r.date,
    })),
}));
const tallest = Math.max(...years.map((y) => y.races.length));

/* ---------- Badwater 135 finishes ---------- */
const toHours = (t: string) => {
  const [h, m, s] = t.split(':').map(Number);
  return h + m / 60 + (s || 0) / 3600;
};
const badwater = races
  .filter((r) => r.race.startsWith('Badwater 135') && r.status === 'finished')
  .sort((a, b) => a.year - b.year)
  .map((r) => ({ year: r.year, time: r.result, hours: toHours(r.result), place: r.placeOverall }));
const bwMax = 40;

// Approximate course profile (miles, feet). Labeled as approximate on the page.
const course: [number, number, string?][] = [
  [0, -282, 'Badwater Basin'],
  [17.4, -165, 'Furnace Creek'],
  [30, -120],
  [41.9, 5, 'Stovepipe Wells'],
  [50, 2600],
  [58.7, 4956, 'Townes Pass'],
  [66, 3200],
  [72.3, 1970, 'Panamint Springs'],
  [80, 4000],
  [90.1, 5050, 'Darwin'],
  [100, 4300],
  [108, 3610, 'Keeler'],
  [122.7, 3727, 'Lone Pine'],
  [128, 5600],
  [135, 8360, 'Whitney Portal'],
];
const EW = 1200, EH = 340, ETOP = 30, EBOT = 300;
const ex = (mi: number) => (mi / 135) * EW;
const ey = (ft: number) => EBOT - ((ft + 282) / (8360 + 282)) * (EBOT - ETOP);
const profilePath = course.map(([mi, ft], i) => `${i ? 'L' : 'M'}${ex(mi).toFixed(1)} ${ey(ft).toFixed(1)}`).join(' ');
const profileFill = `${profilePath} L${EW} ${EH} L0 ${EH} Z`;
const seaLevel = ey(0);

/* ---------- Backyard dial: one tick per yard, one ring per day ---------- */
const YARDS = 111;
const dialTicks = Array.from({ length: YARDS }, (_, i) => {
  const day = Math.floor(i / 24);
  const hour = i % 24;
  const r = 118 + day * 38;
  const a = (hour / 24) * Math.PI * 2 - Math.PI / 2;
  const len = [57, 84, 107, 110].includes(i) ? 13 : 8;
  return {
    i: i + 1,
    x1: 300 + Math.cos(a) * (r - len),
    y1: 300 + Math.sin(a) * (r - len),
    x2: 300 + Math.cos(a) * (r + len),
    y2: 300 + Math.sin(a) * (r + len),
    mark: len > 8,
  };
});

const loopSteps = [
  {
    yard: 1,
    year: 'The format',
    head: 'Every hour, on the hour.',
    body: 'A yard is 4.1667 miles. Runners start a new one each hour, whenever it is, for as long as they can. Miss the bell and you are out. The last runner standing wins, and has to finish one more yard alone.',
  },
  {
    yard: 58,
    year: '2017',
    head: 'The assist.',
    body: '58 yards, 241.7 miles. In a backyard ultra there is no second place, only the runner who helped push the winner there. Harvey took the assist.',
  },
  {
    yard: 85,
    year: '2021',
    head: 'First win.',
    body: '85 yards, 354.2 miles. A world record at the time, finished with a fractured hand.',
  },
  {
    yard: 108,
    year: '2023',
    head: '450 miles. 108 hours.',
    body: 'A world record at the time. Six runners passed 100 hours that year, the first field ever to do it. Harvey was the last one standing.',
  },
  {
    yard: 111,
    year: '2025',
    head: 'Further still.',
    body: '111 yards, 462.5 miles, the furthest he has ever run in one race. He finished third, at 49.',
  },
];

const credit = site.photoCredit;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0e0e0e" />
    <script is:inline>document.documentElement.classList.add('lw-js');</script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <Meta title={title} description={description} noindex />
  </head>
  <body>
    <a href="#top" class="skip">Skip to content</a>

    <header class="bar" data-bar>
      <a href="#top" class="bar-name">Harvey Lewis</a>
      <nav aria-label="Primary">
        <a href="/story">Story</a>
        <a href="/races">Races</a>
        <a href="/speaking">Speaking</a>
        <a href="/media">Media</a>
      </nav>
      <a href="/contact" class="btn btn-line">Enquire</a>
    </header>

    <main id="top">
      <!-- ============ Hero ============ -->
      <section class="hero" aria-labelledby="hero-name">
        <div class="hero-photo">
          <Image
            src={nightRun}
            alt="Harvey Lewis running alone through the dark, lit from the side"
            widths={[800, 1400, 2000, 2736]}
            sizes="(max-width: 760px) 170vw, 80vw"
            loading="eager"
            fetchpriority="high"
          />
        </div>
        <h1 id="hero-name" class="hero-name">
          <span class="rise" style="--d:0">Harvey</span>
          <span class="rise" style="--d:1">Lewis</span>
        </h1>
        <div class="hero-foot">
          <p class="hero-role">Ultrarunner · High school teacher · Cincinnati, Ohio</p>
          <p class="hero-line">
            Two Badwater 135 wins. Two backyard world records. After the second, he was back in his
            classroom within 48 hours.
          </p>
          <a href="/contact" class="btn btn-line btn-lg">
            Sponsorship, speaking &amp; press
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12h15M13 6l6 6-6 6" /></svg>
          </a>
        </div>
      </section>

      <!-- ============ Duality ============ -->
      <section class="salt duality" aria-labelledby="duality-h">
        <div class="duality-text">
          <h2 id="duality-h" class="display-2">Friday morning, he taught class.</h2>
          <p class="lede">
            In October 2023 Harvey Lewis ran 450 miles in 108 hours at Big's Backyard Ultra. He slept in a
            tent, drove home to Cincinnati, and less than 48 hours after finishing, ran to school. He teaches
            financial literacy and American government at the School for Creative and Performing Arts.
          </p>
        </div>
        <figure class="duality-a">
          <Image src={badwaterFinish} alt="Harvey Lewis breaking the Badwater 135 finish tape at night, crew and an American flag behind him" widths={[500, 900, 1300]} sizes="(max-width: 760px) 100vw, 40vw" />
          <figcaption>Badwater 135 finish, Whitney Portal, at night</figcaption>
        </figure>
        <figure class="duality-b">
          <Image src={students} alt="Harvey Lewis speaking to hundreds of schoolchildren outdoors" widths={[480]} sizes="(max-width: 760px) 80vw, 24vw" />
          <figcaption>Speaking to schoolchildren</figcaption>
        </figure>
        <blockquote class="duality-quote">
          <p>“I'm 47, and … I'm racing a bus? What the hell is going on here?”</p>
          <footer>On run-commuting past his students' school bus. iRunFar, 2024</footer>
        </blockquote>
      </section>

      <!-- ============ The loop ============ -->
      <section class="loop" aria-labelledby="loop-h">
        <div class="loop-intro">
          <h2 id="loop-h" class="display-2">The last one standing.</h2>
          <p class="lede">Big's Backyard Ultra, Bell Buckle, Tennessee. Eight starts since 2017.</p>
        </div>
        <div class="loop-stage">
          <div class="loop-dial" aria-hidden="true">
            <svg viewBox="0 0 600 600" class="dial">
              {[0, 1, 2, 3, 4].map((d) => (
                <circle cx="300" cy="300" r={118 + d * 38} class="dial-ring" />
              ))}
              {dialTicks.map((t) => (
                <line x1={t.x1} y1={t.y1} x2={t.x2} y2={t.y2} class:list={['tick', t.mark && 'tick-mark']} data-i={t.i} />
              ))}
            </svg>
            <div class="dial-read">
              <span class="dial-label">Yard</span>
              <span class="dial-num" data-yard>1</span>
              <span class="dial-sub"><span data-miles>4.2</span> mi · <span data-hours>1</span> h</span>
            </div>
          </div>
          <ol class="loop-steps">
            {loopSteps.map((s) => (
              <li class="loop-step" data-step={s.yard}>
                <span class="step-year">{s.year}</span>
                <h3>{s.head}</h3>
                <p>{s.body}</p>
              </li>
            ))}
          </ol>
        </div>
        <figure class="loop-photo">
          <Image src={backyardFlags} alt="Harvey Lewis leading a pack of runners at the start of a yard, wearing a World Backyard Ultra Championships shirt" widths={[800, 1400, 2048]} sizes="100vw" />
          <figcaption>
            <blockquote>“There are powers that exist to push us beyond what seems reasonable.”</blockquote>
            <span>iRunFar, after the 2023 race</span>
          </figcaption>
        </figure>
      </section>

      <!-- ============ Badwater ============ -->
      <section class="salt badwater" aria-labelledby="bw-h">
        <div class="bw-head">
          <h2 id="bw-h" class="display-2">From 282 feet below sea level to 8,360 above.</h2>
          <p class="lede">
            Badwater 135 crosses Death Valley in July and climbs to the foot of Mount Whitney. Harvey has
            finished it {badwater.length} times since 2011 and won it twice.
          </p>
        </div>

        <figure class="profile" data-draw>
          <svg viewBox={`0 0 ${EW} ${EH}`} preserveAspectRatio="none" aria-hidden="true">
            <path d={profileFill} class="profile-fill" />
            <line x1="0" x2={EW} y1={seaLevel} y2={seaLevel} class="profile-sea" />
            <path d={profilePath} class="profile-line" pathLength="1" />
          </svg>
          <ol class="profile-labels">
            {course.filter((c) => c[2]).map(([mi, ft, name]) => (
              <li style={`--x:${(mi / 135) * 100}%; --y:${(ey(ft) / EH) * 100}%`}>
                <span class="pl-name">{name}</span>
                <span class="pl-ft">{ft.toLocaleString('en-US')} ft · mi {mi}</span>
              </li>
            ))}
          </ol>
          <figcaption>Approximate course profile. Sea level marked.</figcaption>
        </figure>

        <div class="bw-body">
          <div class="bw-photo">
            <Image src={saltFlat} alt="Harvey Lewis running across the salt flat toward a low sun" widths={[540, 1080]} sizes="(max-width: 760px) 100vw, 30vw" />
          </div>
          <div class="finishes">
            <h3 class="finishes-h">{badwater.length} finishes, finish time in hours</h3>
            <ol class="fin-list">
              {badwater.map((b) => (
                <li class:list={['fin', b.place === 1 && 'fin-win']}>
                  <span class="fin-year">{b.year}</span>
                  <span class="fin-track"><span class="fin-bar" style={`--w:${(b.hours / bwMax) * 100}%`}></span></span>
                  <span class="fin-time">{b.time}</span>
                  <span class="fin-place">{ordinal(b.place)}</span>
                </li>
              ))}
            </ol>
            <p class="fin-note">
              2024: after finishing, he turned around at Whitney Portal and ran back to Badwater Basin, 270
              miles in all. 2020: no race; he ran from Badwater Basin to the summit of Mount Whitney in
              33:32 on his own.
            </p>
          </div>
        </div>

        <ul class="strip" aria-label="Death Valley photographs by Mike Trimpe">
          <li><Image src={stovepipe29} alt="Harvey Lewis running in a white sun hood on the Death Valley road" widths={[640]} sizes="(max-width: 760px) 80vw, 30vw" /></li>
          <li><Image src={switchback} alt="A lone runner on a curving desert road cut into the mountainside" widths={[640]} sizes="(max-width: 760px) 80vw, 30vw" /></li>
          <li><Image src={stovepipe33} alt="Harvey Lewis and a pacer running beside the guardrail below brown mountains" widths={[640]} sizes="(max-width: 760px) 80vw, 30vw" /></li>
          <li><Image src={keeler} alt="Two runners on a straight desert highway toward the Sierra" widths={[640]} sizes="(max-width: 760px) 80vw, 30vw" /></li>
          <li><Image src={stovepipe24} alt="Harvey Lewis and crew at the roadside with the valley road behind them" widths={[640]} sizes="(max-width: 760px) 80vw, 30vw" /></li>
        </ul>
      </section>

      <!-- ============ Thirty years ============ -->
      <section class="years" aria-labelledby="years-h">
        <div class="years-head">
          <h2 id="years-h" class="display-2">{races.length} results. {wins} wins. Thirty years.</h2>
          <p class="lede">Every race on record since {firstYear}, one mark each. Wins in yellow.</p>
        </div>

        <div class="chart" style={`--rows:${tallest}`} data-chart>
          <div class="chart-gap" aria-hidden="true">
            <p>
              No results, 2000–2005. A broken neck, around 2004.
              <span>“After that event I actually have become so much faster.” WVXU, 2014</span>
            </p>
          </div>
          <ol class="chart-cols" aria-hidden="true">
            {years.map((y) => (
              <li class="col">
                <span class="col-marks">
                  {y.races.map((r) => (
                    <span class={`m m-${r.kind}`} data-label={`${r.date.slice(0, 4)} · ${r.label}`}></span>
                  ))}
                </span>
                <span class:list={['col-year', y.year === lastYear && y.year % 5 !== 0 && 'col-year-edge']}>{y.year % 5 === 0 || y.year === firstYear || y.year === lastYear ? y.year : ''}</span>
              </li>
            ))}
          </ol>
          <p class="chart-read" aria-live="polite" data-read>Point at a mark to read the race.</p>
          <ul class="chart-key" aria-hidden="true">
            <li><span class="m m-win"></span>Win</li>
            <li><span class="m m-podium"></span>Podium</li>
            <li><span class="m m-finish"></span>Finish</li>
            <li><span class="m m-dnf"></span>Did not finish</li>
          </ul>
        </div>
        <a href="/races" class="text-link">
          Every result, with times and places
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12h15M13 6l6 6-6 6" /></svg>
        </a>
      </section>

      <!-- ============ Close ============ -->
      <section class="close" aria-labelledby="close-h">
        <h2 id="close-h" class="display-close">Work with Harvey.</h2>
        <ul class="close-list">
          <li>
            <a href="/contact">
              <span class="cl-name">Sponsorship</span>
              <span class="cl-desc">Footwear, nutrition, recovery. A long-form story told across 228k+ followers.</span>
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12h15M13 6l6 6-6 6" /></svg>
            </a>
          </li>
          <li>
            <a href="/speaking">
              <span class="cl-name">Speaking</span>
              <span class="cl-desc">Keynotes for companies, schools and endurance events, booked around the school year.</span>
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12h15M13 6l6 6-6 6" /></svg>
            </a>
          </li>
          <li>
            <a href="/media">
              <span class="cl-name">Press &amp; interviews</span>
              <span class="cl-desc">Media kit, photography and a record of every race since 1996.</span>
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12h15M13 6l6 6-6 6" /></svg>
            </a>
          </li>
        </ul>
        <p class="close-mail">Or write directly: <a href={`mailto:${site.enquiryEmail}`}>{site.enquiryEmail}</a></p>
      </section>
    </main>

    <footer class="foot">
      <span>Harvey Lewis · Cincinnati, Ohio</span>
      <a href={site.instagramUrl}>{site.instagramHandle}</a>
      <span>{credit}</span>
    </footer>

    <script>
      const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

      // Header gains a ground once the hero has scrolled away.
      const bar = document.querySelector<HTMLElement>('[data-bar]');
      const hero = document.querySelector('.hero');
      if (bar && hero) {
        new IntersectionObserver(([e]) => bar.classList.toggle('is-solid', !e.isIntersecting), {
          rootMargin: '-80px 0px 0px 0px',
        }).observe(hero);
      }

      // Backyard dial: ticks accrue toward the active step's yard count.
      const ticks = [...document.querySelectorAll<SVGLineElement>('.tick')];
      const numEl = document.querySelector('[data-yard]');
      const miEl = document.querySelector('[data-miles]');
      const hEl = document.querySelector('[data-hours]');
      const YARD_MI = 4.166667;
      let shown = 1;
      let target = 1;
      let raf = 0;
      const paint = (n: number) => {
        ticks.forEach((t, i) => {
          t.classList.toggle('on', i < n);
          t.classList.toggle('head', i === n - 1);
        });
        if (numEl) numEl.textContent = String(n);
        if (miEl) miEl.textContent = (n * YARD_MI).toFixed(1);
        if (hEl) hEl.textContent = String(n);
      };
      const run = () => {
        const from = shown;
        const start = performance.now();
        const dur = Math.min(1400, 300 + Math.abs(target - from) * 14);
        cancelAnimationFrame(raf);
        const step = (now: number) => {
          const p = Math.min(1, (now - start) / dur);
          const eased = 1 - Math.pow(2, -10 * p);
          shown = Math.round(from + (target - from) * (p === 1 ? 1 : eased));
          paint(shown);
          if (p < 1) raf = requestAnimationFrame(step);
        };
        raf = requestAnimationFrame(step);
      };
      const steps = [...document.querySelectorAll<HTMLElement>('[data-step]')];
      paint(1);
      const stepObserver = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (!e.isIntersecting) continue;
            steps.forEach((s) => s.classList.toggle('is-active', s === e.target));
            target = Number((e.target as HTMLElement).dataset.step);
            if (reduce) {
              shown = target;
              paint(target);
            } else run();
          }
        },
        { rootMargin: matchMedia('(max-width: 900px)').matches ? '-68% 0px -22% 0px' : '-45% 0px -45% 0px' },
      );
      steps.forEach((s) => stepObserver.observe(s));

      // Badwater profile draws itself once, when it reaches the viewport.
      const draw = document.querySelector('[data-draw]');
      if (draw) {
        new IntersectionObserver(
          ([e], o) => {
            if (e.isIntersecting) {
              draw.classList.add('is-drawn');
              o.disconnect();
            }
          },
          { threshold: 0.35 },
        ).observe(draw);
      }

      // Thirty-year chart: pointing at a mark reads the race aloud in the caption line.
      const read = document.querySelector('[data-read]');
      const chart = document.querySelector('[data-chart]');
      if (read && chart) {
        const idle = read.textContent;
        chart.addEventListener('pointerover', (e) => {
          const m = (e.target as HTMLElement).closest<HTMLElement>('[data-label]');
          if (!m) return;
          chart.querySelectorAll('.is-hot').forEach((x) => x.classList.remove('is-hot'));
          m.classList.add('is-hot');
          read.textContent = m.dataset.label ?? '';
        });
        chart.addEventListener('pointerleave', () => {
          chart.querySelectorAll('.is-hot').forEach((x) => x.classList.remove('is-hot'));
          read.textContent = idle;
        });
      }
    </script>

    <style is:global>
      :root {
        --asphalt: #0e0e0e;
        --asphalt-2: #1b1b1a;
        --salt: #e7e6e2;
        --salt-2: #d9d8d2;
        --line: #f2c230;
        --ink: #e7e6e2;
        --ink-dim: rgba(231, 230, 226, 0.7);
        --ink-faint: rgba(231, 230, 226, 0.5);
        --rule: rgba(231, 230, 226, 0.16);
        --dark: #121211;
        --dark-dim: #4b4a46;
        --dark-rule: rgba(18, 18, 17, 0.18);

        --display: 'Big Shoulders Variable', 'Arial Narrow', sans-serif;
        --text: 'Source Serif 4 Variable', Georgia, serif;

        --gut: clamp(16px, 4vw, 64px);
        --sec: clamp(96px, 11vw, 190px);
        --ease: cubic-bezier(0.16, 1, 0.3, 1);
        color-scheme: dark;
      }

      *, *::before, *::after { box-sizing: border-box; }
      html { -webkit-text-size-adjust: 100%; scroll-behavior: smooth; }
      body {
        margin: 0;
        background: var(--asphalt);
        color: var(--ink);
        font-family: var(--text);
        font-size: clamp(18px, 1.15vw, 21px);
        line-height: 1.55;
        font-optical-sizing: auto;
        -webkit-font-smoothing: antialiased;
        overflow-x: hidden;
      }
      img { display: block; max-width: 100%; height: auto; }
      h1, h2, h3, p, figure, blockquote, ol, ul { margin: 0; padding: 0; }
      ol, ul { list-style: none; }
      a { color: inherit; }
      ::selection { background: var(--line); color: var(--dark); }
      :focus-visible { outline: 3px solid var(--line); outline-offset: 3px; }
      .salt :focus-visible, .close :focus-visible { outline-color: var(--dark); }
      html { scrollbar-color: #3a3a38 var(--asphalt); }

      .skip {
        position: absolute; left: 12px; top: -60px; z-index: 100;
        background: var(--line); color: var(--dark); padding: 10px 14px;
        font-family: var(--display); font-weight: 700; text-transform: uppercase;
      }
      .skip:focus { top: 12px; }

      /* ---------- Shared type ---------- */
      .display-2 {
        font-family: var(--display);
        font-weight: 800;
        text-transform: uppercase;
        font-size: clamp(44px, 6.4vw, 104px);
        line-height: 0.9;
        letter-spacing: -0.005em;
        text-wrap: balance;
      }
      .lede {
        font-size: clamp(19px, 1.45vw, 25px);
        line-height: 1.45;
        max-width: 38ch;
        text-wrap: pretty;
        color: var(--ink-dim);
      }
      .salt .lede { color: var(--dark-dim); }
      figcaption, .label {
        font-family: var(--display);
        font-weight: 600;
        font-size: 15px;
        letter-spacing: 0.06em;
        text-transform: uppercase;
      }

      .btn {
        display: inline-flex; align-items: center; gap: 12px;
        min-height: 44px; padding: 0 18px;
        font-family: var(--display); font-weight: 750; font-size: 17px;
        letter-spacing: 0.05em; text-transform: uppercase; text-decoration: none;
        transition: background-color 0.25s var(--ease), color 0.25s var(--ease);
      }
      .btn svg, .text-link svg, .close-list svg {
        width: 1.1em; height: 1.1em; fill: none; stroke: currentColor; stroke-width: 2.2;
        transition: transform 0.35s var(--ease);
      }
      .btn:hover svg, .text-link:hover svg { transform: translateX(4px); }
      .btn-line { background: var(--line); color: var(--dark); }
      .btn-line:hover { background: var(--ink); }
      .btn-lg { min-height: 60px; padding: 0 26px; font-size: 20px; }

      /* ---------- Top bar ---------- */
      .bar {
        position: fixed; inset: 0 0 auto; z-index: 50;
        display: flex; align-items: center; gap: 32px;
        padding: 14px var(--gut);
        transition: background-color 0.35s var(--ease), border-color 0.35s var(--ease);
        border-bottom: 1px solid transparent;
      }
      .bar.is-solid { background: var(--asphalt); border-bottom-color: var(--rule); }
      .bar-name {
        font-family: var(--display); font-weight: 800; font-size: 20px;
        letter-spacing: 0.04em; text-transform: uppercase; text-decoration: none;
        margin-right: auto; opacity: 0; transition: opacity 0.35s var(--ease);
      }
      .bar.is-solid .bar-name { opacity: 1; }
      .bar nav { display: flex; gap: 28px; }
      .bar nav a {
        font-family: var(--display); font-weight: 600; font-size: 17px;
        letter-spacing: 0.06em; text-transform: uppercase; text-decoration: none;
        color: var(--ink-dim); padding: 10px 0;
        transition: color 0.2s;
      }
      .bar nav a:hover { color: var(--ink); }

      /* ---------- Hero ---------- */
      .hero {
        position: relative;
        min-height: 100svh;
        background: #0e0e0e;
        display: grid;
        grid-template-columns: 1fr;
        grid-template-rows: 1fr auto;
        padding: 96px var(--gut) clamp(28px, 4vw, 56px);
        overflow: hidden;
        isolation: isolate;
      }
      .hero-photo {
        position: absolute; z-index: -1;
        top: 0; bottom: 0; left: 31%; right: -8%;
        -webkit-mask-image: linear-gradient(90deg, transparent, #000 14%);
        mask-image: linear-gradient(90deg, transparent, #000 14%);
      }
      .hero-photo img { width: 100%; height: 100%; object-fit: cover; object-position: 50% 45%; }
      .hero-name {
        align-self: start;
        font-family: var(--display);
        font-weight: 900;
        text-transform: uppercase;
        font-size: clamp(96px, min(17vw, 27svh), 330px);
        line-height: 0.8;
        letter-spacing: -0.01em;
        color: var(--salt);
        margin-top: clamp(8px, 3vh, 40px);
      }
      .hero-name span { display: block; }
      .hero-foot {
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr) auto;
        align-items: end;
        gap: 24px 48px;
        padding-top: 24px;
        border-top: 1px solid var(--rule);
      }
      .hero-role {
        font-family: var(--display); font-weight: 650; font-size: 18px;
        letter-spacing: 0.06em; text-transform: uppercase; color: var(--ink);
      }
      .hero-line { font-size: clamp(18px, 1.3vw, 22px); max-width: 44ch; color: var(--ink-dim); }

      .lw-js .rise {
        animation: rise 1.2s var(--ease) both;
        animation-delay: calc(0.15s + var(--d) * 0.12s);
      }
      @keyframes rise {
        from { clip-path: inset(0 0 100% 0); transform: translateY(0.25em); }
        to { clip-path: inset(0 0 0 0); transform: none; }
      }

      /* ---------- Salt sections ---------- */
      .salt { background: var(--salt); color: var(--dark); color-scheme: light; }

      /* ---------- Duality ---------- */
      .duality {
        display: grid;
        grid-template-columns: repeat(12, minmax(0, 1fr));
        gap: 0 clamp(16px, 2vw, 32px);
        padding: var(--sec) var(--gut);
      }
      .duality-text { grid-column: 1 / span 7; }
      .duality-text .lede { margin-top: clamp(24px, 2.5vw, 40px); }
      .duality-a { grid-column: 7 / span 6; grid-row: 2 / span 2; margin-top: clamp(48px, 6vw, 96px); }
      .duality-b { grid-column: 2 / span 4; grid-row: 2; margin-top: clamp(64px, 9vw, 160px); }
      .duality figure img { width: 100%; }
      .duality-a img { aspect-ratio: 4 / 5; object-fit: cover; object-position: 50% 60%; }
      .duality-b img { aspect-ratio: 3 / 4; object-fit: cover; }
      .duality figcaption { margin-top: 12px; color: var(--dark-dim); }
      .duality-quote {
        grid-column: 1 / span 5; grid-row: 3; align-self: end;
        padding-top: 48px;
      }
      .duality-quote p {
        font-size: clamp(24px, 2.2vw, 36px); line-height: 1.25;
        font-weight: 450; text-wrap: balance; max-width: 22ch;
      }
      .duality-quote footer {
        margin-top: 16px; font-family: var(--display); font-weight: 600; font-size: 15px;
        letter-spacing: 0.06em; text-transform: uppercase; color: var(--dark-dim);
      }

      /* ---------- Loop ---------- */
      .loop { padding: var(--sec) 0 0; }
      .loop-intro { padding: 0 var(--gut); display: grid; gap: clamp(20px, 2vw, 32px); }
      .loop-stage {
        display: grid;
        grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
        gap: clamp(24px, 5vw, 96px);
        padding: 0 var(--gut);
      }
      .loop-dial {
        position: sticky; top: 0; height: 100svh;
        display: grid; place-items: center;
      }
      .dial { width: min(100%, 78svh); height: auto; overflow: visible; }
      .dial-ring { fill: none; stroke: var(--rule); stroke-width: 1; }
      .tick {
        stroke: rgba(231, 230, 226, 0.2); stroke-width: 3.2; stroke-linecap: butt;
        transition: stroke 0.25s;
      }
      .tick.on { stroke: var(--ink); }
      .tick-mark { stroke-width: 4; }
      .tick.head { stroke: var(--line); }
      .dial-read {
        position: absolute; display: grid; justify-items: center; text-align: center;
        font-family: var(--display); text-transform: uppercase;
      }
      .dial-label { font-weight: 600; font-size: 15px; letter-spacing: 0.1em; color: var(--ink-faint); }
      .dial-num {
        font-weight: 850; font-size: clamp(64px, 7vw, 124px); line-height: 0.85;
        font-variant-numeric: tabular-nums; color: var(--line);
      }
      .dial-sub { font-weight: 600; font-size: 17px; letter-spacing: 0.06em; color: var(--ink-dim); margin-top: 8px; font-variant-numeric: tabular-nums; }
      .loop-steps { padding: 30svh 0 40svh; }
      .loop-step {
        min-height: 70svh; display: flex; flex-direction: column; justify-content: center;
        opacity: 0.32; transition: opacity 0.5s var(--ease);
        max-width: 30em;
      }
      .loop-step.is-active { opacity: 1; }
      .lw-js .loop-step:not(.is-active) { opacity: 0.32; }
      .step-year {
        font-family: var(--display); font-weight: 700; font-size: 17px;
        letter-spacing: 0.08em; text-transform: uppercase; color: var(--line);
      }
      .loop-step h3 {
        font-family: var(--display); font-weight: 800; text-transform: uppercase;
        font-size: clamp(36px, 3.6vw, 60px); line-height: 0.95; margin: 12px 0 20px;
      }
      .loop-step p { color: var(--ink-dim); max-width: 34ch; }
      .loop-photo { position: relative; margin-top: clamp(40px, 6vw, 96px); }
      .loop-photo img { width: 100%; height: min(92svh, 62vw); object-fit: cover; object-position: 50% 30%; }
      .loop-photo figcaption {
        text-transform: none; letter-spacing: 0; font-weight: 400;
        padding: clamp(28px, 3vw, 48px) var(--gut) var(--sec);
        display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: end; gap: 16px 48px;
      }
      .loop-photo blockquote {
        font-family: var(--text); font-size: clamp(28px, 3.2vw, 54px); line-height: 1.15;
        font-weight: 420; max-width: 24ch; text-wrap: balance;
      }
      .loop-photo figcaption span {
        font-family: var(--display); font-weight: 600; font-size: 15px;
        letter-spacing: 0.06em; text-transform: uppercase; color: var(--ink-faint);
      }

      /* ---------- Badwater ---------- */
      .badwater { padding: var(--sec) var(--gut); }
      .bw-head { display: grid; grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr); gap: 32px 64px; align-items: end; }
      .profile { position: relative; margin-top: clamp(56px, 7vw, 120px); }
      .profile svg { display: block; width: 100%; height: clamp(200px, 26vw, 400px); overflow: visible; }
      .profile-fill { fill: var(--salt-2); }
      .profile-sea { stroke: var(--dark); stroke-width: 1; stroke-dasharray: 6 6; vector-effect: non-scaling-stroke; opacity: 0.5; }
      .profile-line {
        fill: none; stroke: var(--dark); stroke-width: 3; vector-effect: non-scaling-stroke;
        stroke-linejoin: round;
      }
      .lw-js .profile-line { stroke-dasharray: 1; stroke-dashoffset: 1; transition: stroke-dashoffset 2.4s var(--ease); }
      .lw-js .profile.is-drawn .profile-line { stroke-dashoffset: 0; }
      .profile-labels { position: absolute; inset: 0 0 auto; height: clamp(200px, 26vw, 400px); pointer-events: none; }
      .profile-labels li {
        position: absolute; left: var(--x); top: var(--y);
        transform: translate(-1px, calc(-100% - 14px));
        display: grid; gap: 2px; padding-left: 8px;
        border-left: 1px solid var(--dark);
        font-family: var(--display); text-transform: uppercase; white-space: nowrap;
      }
      .profile-labels li:last-child { transform: translate(calc(-100% + 1px), calc(-100% - 14px)); border-left: 0; border-right: 1px solid var(--dark); padding: 0 8px 0 0; text-align: right; }
      .pl-name { font-weight: 750; font-size: 16px; letter-spacing: 0.04em; }
      .pl-ft { font-weight: 550; font-size: 13px; letter-spacing: 0.05em; color: var(--dark-dim); font-variant-numeric: tabular-nums; }
      .profile-labels li:nth-child(2), .profile-labels li:nth-child(5), .profile-labels li:nth-child(7) {
        transform: translate(-1px, 22px);
      }
      .profile figcaption { margin-top: 64px; color: var(--dark-dim); }

      .bw-body {
        display: grid; grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
        gap: clamp(32px, 6vw, 112px); margin-top: clamp(72px, 9vw, 150px); align-items: start;
      }
      .bw-photo img { width: 100%; aspect-ratio: 2 / 3; object-fit: cover; }
      .finishes-h {
        font-family: var(--display); font-weight: 750; font-size: 20px;
        letter-spacing: 0.05em; text-transform: uppercase;
        padding-bottom: 14px; border-bottom: 2px solid var(--dark);
      }
      .fin {
        display: grid; grid-template-columns: 3.2em minmax(0, 1fr) 5.2em 3em;
        align-items: center; gap: 16px;
        padding: 9px 0; border-bottom: 1px solid var(--dark-rule);
        font-family: var(--display); font-weight: 600; font-size: 18px;
        font-variant-numeric: tabular-nums;
      }
      .fin-track { height: 10px; }
      .fin-bar { display: block; height: 100%; width: var(--w); background: var(--dark-dim); opacity: 0.55; }
      .fin-win .fin-bar { background: var(--dark); opacity: 1; }
      .fin-time { text-align: right; }
      .fin-place { text-align: right; color: var(--dark-dim); }
      .fin-win .fin-place {
        color: var(--dark); background: var(--line); text-align: center; font-weight: 800;
        padding: 1px 0;
      }
      .fin-note { margin-top: 24px; font-size: 17px; color: var(--dark-dim); max-width: 52ch; }

      .strip {
        display: grid; grid-auto-flow: column; grid-auto-columns: minmax(260px, 1fr);
        gap: clamp(8px, 1vw, 16px);
        margin: clamp(72px, 9vw, 150px) calc(var(--gut) * -1) 0;
        padding: 0 var(--gut);
        overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: thin;
      }
      .strip li { scroll-snap-align: start; }
      .strip img { width: 100%; aspect-ratio: 3 / 2; object-fit: cover; }

      /* ---------- Thirty years ---------- */
      .years { padding: var(--sec) var(--gut); }
      .years-head { display: grid; gap: clamp(20px, 2vw, 32px); }
      .chart { position: relative; margin-top: clamp(56px, 7vw, 110px); }
      .chart-cols {
        display: grid;
        grid-template-columns: repeat(31, minmax(0, 1fr));
        gap: 0 clamp(3px, 0.5vw, 8px);
        border-bottom: 2px solid var(--ink);
      }
      .col { display: grid; grid-template-rows: auto; position: relative; }
      .col-marks {
        display: flex; flex-direction: column-reverse; gap: clamp(3px, 0.4vw, 6px);
        min-height: calc(var(--rows) * (clamp(10px, 1.5vw, 22px) + clamp(3px, 0.4vw, 6px)));
        padding-bottom: clamp(3px, 0.4vw, 6px);
      }
      .col-year {
        position: absolute; top: 100%; left: 0; margin-top: 10px;
        font-family: var(--display); font-weight: 650; font-size: 15px; letter-spacing: 0.04em;
        color: var(--ink-dim); font-variant-numeric: tabular-nums;
      }
      .m {
        display: block; width: 100%; height: clamp(10px, 1.5vw, 22px);
        transition: transform 0.2s var(--ease), background-color 0.2s;
      }
      .m-win { background: var(--line); }
      .m-podium { background: var(--ink); }
      .m-finish { box-shadow: inset 0 0 0 1.5px var(--ink-dim); }
      .m-dnf { background: repeating-linear-gradient(135deg, var(--ink-faint) 0 1.5px, transparent 1.5px 5px); }
      .m.is-hot { transform: scaleX(1.35); background-color: var(--ink); box-shadow: none; }
      .chart-gap {
        position: absolute; top: 0; bottom: 0;
        left: calc(4 / 31 * 100%); width: calc(6 / 31 * 100%);
        display: flex; align-items: flex-start; padding-top: 4px;
        border-left: 1px dashed var(--rule); border-right: 1px dashed var(--rule);
      }
      .chart-gap p {
        padding: 0 12px; font-size: 15px; line-height: 1.35; max-width: 20ch; color: var(--ink);
        text-wrap: pretty;
      }
      .chart-gap span { display: block; margin-top: 8px; color: var(--ink-faint); font-size: 15px; }
      .chart-read {
        margin-top: 56px; min-height: 1.5em;
        font-family: var(--display); font-weight: 650; font-size: 19px;
        letter-spacing: 0.04em; text-transform: uppercase; color: var(--ink);
      }
      .chart-key {
        display: flex; flex-wrap: wrap; gap: 8px 28px; margin-top: 16px;
        font-family: var(--display); font-weight: 600; font-size: 15px;
        letter-spacing: 0.06em; text-transform: uppercase; color: var(--ink-dim);
      }
      .chart-key li { display: flex; align-items: center; gap: 10px; }
      .chart-key .m { width: 22px; height: 12px; }
      .text-link {
        display: inline-flex; align-items: center; gap: 10px; margin-top: 40px; min-height: 44px;
        font-family: var(--display); font-weight: 750; font-size: 19px;
        letter-spacing: 0.05em; text-transform: uppercase; text-decoration: none;
        color: var(--line);
      }

      /* ---------- Close ---------- */
      .close { background: var(--line); color: var(--dark); padding: var(--sec) var(--gut); color-scheme: light; }
      .display-close {
        font-family: var(--display); font-weight: 900; text-transform: uppercase;
        font-size: clamp(64px, 11vw, 200px); line-height: 0.82; letter-spacing: -0.01em;
      }
      .close-list { margin-top: clamp(48px, 6vw, 96px); border-top: 2px solid var(--dark); }
      .close-list a {
        display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.3fr) auto;
        align-items: center; gap: 12px 48px;
        padding: clamp(20px, 2.2vw, 32px) 0; border-bottom: 1px solid rgba(18, 18, 17, 0.3);
        text-decoration: none;
      }
      .cl-name, .cl-desc { transition: transform 0.4s var(--ease); }
      .close-list a:hover .cl-name, .close-list a:hover .cl-desc { transform: translateX(12px); }
      .close-list a:hover svg { transform: translateX(6px); }
      .cl-name {
        font-family: var(--display); font-weight: 850; text-transform: uppercase;
        font-size: clamp(34px, 3.8vw, 64px); line-height: 0.95;
      }
      .cl-desc { font-size: clamp(17px, 1.2vw, 20px); max-width: 40ch; }
      .close-list svg { width: 36px; height: 36px; stroke-width: 2; }
      .close-mail { margin-top: 40px; font-size: 19px; }
      .close-mail a { text-underline-offset: 4px; text-decoration-thickness: 1.5px; font-weight: 600; }

      .foot {
        display: flex; flex-wrap: wrap; gap: 12px 40px; justify-content: space-between;
        padding: 36px var(--gut);
        font-family: var(--display); font-weight: 600; font-size: 15px;
        letter-spacing: 0.06em; text-transform: uppercase; color: var(--ink-dim);
      }
      .foot a { text-decoration: none; color: var(--ink); }
      .foot a:hover { color: var(--line); }

      /* ---------- Narrow screens ---------- */
      @media (max-width: 900px) {
        .bar nav { display: none; }
        .bar { justify-content: flex-end; }
        .hero { padding-top: 84px; }
        .hero-photo { left: -20%; right: -30%; top: 33%; -webkit-mask-image: none; mask-image: none; }
        .hero-photo img { object-position: 52% 50%; }
        .hero-name { font-size: min(34vw, 190px); }
        .hero-foot { grid-template-columns: 1fr; background: #0e0e0e; margin: 0 calc(var(--gut) * -1); padding: 20px var(--gut) 0; }
        .hero-foot .btn { justify-self: stretch; justify-content: space-between; font-size: 18px; }
        .dial-num { font-size: 56px; }
        .dial-sub { font-size: 13px; margin-top: 4px; }
        .dial-label { font-size: 12px; }
        .col-year-edge { display: none; }

        .duality { grid-template-columns: repeat(6, minmax(0, 1fr)); }
        .duality-text { grid-column: 1 / -1; }
        .duality-a { grid-column: 2 / -1; grid-row: auto; }
        .duality-b { grid-column: 1 / span 4; grid-row: auto; margin-top: 32px; }
        .duality-quote { grid-column: 1 / -1; grid-row: auto; }

        .loop-stage { grid-template-columns: 1fr; }
        .loop-dial { top: 56px; height: 46svh; z-index: 1; background: var(--asphalt); }
        .dial { width: min(100%, 42svh); }
        .loop-steps { padding: 4svh 0 20svh; }
        .loop-step { min-height: 52svh; }
        .loop-photo figcaption { grid-template-columns: 1fr; }

        .bw-head, .bw-body { grid-template-columns: 1fr; }
        .bw-photo { max-width: 420px; }
        .profile-labels .pl-ft { display: none; }
        .profile-labels li:nth-child(2), .profile-labels li:nth-child(4), .profile-labels li:nth-child(6), .profile-labels li:nth-child(8) { display: none; }
        .pl-name { font-size: 13px; }

        .chart-gap { display: none; }
        .col-year { font-size: 12px; }

        .close-list a { grid-template-columns: minmax(0, 1fr) auto; }
        .cl-desc { grid-column: 1; grid-row: 2; }
        .close-list svg { grid-row: 1 / span 2; grid-column: 2; }
      }

      @media (prefers-reduced-motion: reduce) {
        html { scroll-behavior: auto; }
        .lw-js .rise { animation: none; }
        .lw-js .profile-line { stroke-dashoffset: 0; transition: none; }
        .tick, .loop-step, .m, .cl-name, .cl-desc, .btn svg { transition: none; }
      }
    </style>
  </body>
</html>
