---
import { Image } from 'astro:assets';
import SiteHeader from './SiteHeader.astro';
import races from '../data/races.json';
import heroImage from '../assets/photos/hero-silhouette.jpg';

// Race count and first year come from the data so the rail can't drift as results land.
const raceCount = races.length;
const firstYear = Math.min(...races.map((race) => race.year));

const facts = [
  { figure: '30', label: 'Years of ultrarunning' },
  { figure: '15×', label: 'Badwater finishes (2× win)' },
  { figure: '5×', label: 'Team USA appearances' },
  { figure: String(raceCount), label: `Races since ${firstYear}` },
];
---

<section id="top" class="hero">
  <div class="hero-photo-wrap">
    <Image
      src={heroImage}
      alt="Harvey Lewis running in silhouette at dusk"
      class="hero-photo"
      widths={[900, 1440, 2000, 2736]}
      sizes="(max-width: 860px) 100vw, 60vw"
      loading="eager"
      fetchpriority="high"
    />
  </div>

  <SiteHeader variant="overlay" />

  <div class="hero-center">
    <div class="hero-content" data-reveal-group data-reveal-step="110">
      <div class="eyebrow eyebrow-rust hero-eyebrow" data-reveal>
        Cincinnati, Ohio — ultrarunner &amp; high school teacher
      </div>
      <h1 data-reveal>The limits we believe in are the only ones that exist.</h1>
      <p class="hero-body" data-reveal>
        Told he might never run again after a broken neck in 2004, Harvey Lewis turned survival into
        a thirty-year masterclass in human resilience. Two-time champion of Death Valley’s Badwater 135,
        five-time Team USA athlete, and a Cincinnati public school teacher—he proves every day that
        extraordinary willpower isn't genetic, but a daily practice.
      </p>
      <div class="cta-row" data-reveal>
        <a href="/contact" class="btn btn-solid">Sponsorship &amp; speaking →</a>
        <a href="/media" class="btn btn-outline">Media kit</a>
      </div>
    </div>
  </div>

  <a href="#story" class="scroll-cue" aria-label="Scroll to content">
    <span></span>
  </a>

  <div class="hero-bottom">
    <div class="fact-rail" data-reveal-group data-reveal-step="90">
      {
        facts.map((fact) => (
          <div data-reveal>
            <div class="figure" data-count>{fact.figure}</div>
            <div class="fact-label">{fact.label}</div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  /* grid-template-columns: minmax(0, 1fr) is required — without it the fact
     rail's min-content width overflows the viewport and clips the headline. */
  .hero {
    position: relative;
    min-height: 100vh;
    min-height: 100svh;
    overflow: hidden;
    display: grid;
    grid-template-rows: auto 1fr auto;
    grid-template-columns: minmax(0, 1fr);
    background: var(--bg);
  }

  .hero-photo-wrap {
    position: absolute;
    top: 0;
    bottom: 0;
    right: 0;
    width: 62vw;
    max-width: 1200px;
    height: 100%;
    overflow: hidden;
    pointer-events: none;
    mask-image: linear-gradient(to right, transparent 0%, black 18%);
    -webkit-mask-image: linear-gradient(to right, transparent 0%, black 18%);
  }

  .hero-photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 46% 40%;
    animation: hero-settle 1.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  @keyframes hero-settle {
    0% {
      transform: scale(1.04);
    }
    100% {
      transform: scale(1);
    }
  }

  .hero-center {
    position: relative;
    align-self: center;
    width: 100%;
    max-width: var(--max-w);
    margin: 0 auto;
    padding: 30px var(--pad-x);
    z-index: 2;
  }

  .hero-content {
    max-width: 580px;
  }

  .hero-eyebrow {
    letter-spacing: 0.2em;
  }

  .hero-center h1 {
    margin-top: 20px;
    font-weight: 600;
    font-size: clamp(32px, 4.5vw, 68px);
    line-height: 1.05;
    letter-spacing: -0.02em;
    max-width: 17ch;
  }

  .hero-body {
    margin-top: 24px;
    max-width: 48ch;
    font-size: 18px;
    line-height: 1.62;
    color: rgba(237, 228, 211, 0.88);
    text-wrap: pretty;
  }

  .hero-bottom {
    position: relative;
    padding: 0 var(--pad-x) 30px;
    z-index: 2;
  }

  /* Minimalist loop pacer scroll cue */
  .scroll-cue {
    position: absolute;
    left: 50%;
    bottom: 124px;
    translate: -50%;
    z-index: 3;
    width: 22px;
    height: 38px;
    border: 1px solid rgba(237, 228, 211, 0.35);
    display: flex;
    justify-content: center;
    transition: border-color 0.2s ease;
  }

  .scroll-cue:hover,
  .scroll-cue:focus-visible {
    border-color: var(--rust);
  }

  .scroll-cue span {
    position: absolute;
    top: 6px;
    width: 2px;
    height: 6px;
    background: var(--rust);
    animation: scroll-dot 2.2s cubic-bezier(0.65, 0, 0.35, 1) infinite;
  }

  @keyframes scroll-dot {
    0% {
      transform: translateY(0);
      opacity: 0;
    }
    30% {
      opacity: 1;
    }
    70% {
      transform: translateY(16px);
      opacity: 0.9;
    }
    100% {
      transform: translateY(20px);
      opacity: 0;
    }
  }

  @media (max-width: 860px) {
    .hero {
      grid-template-rows: auto auto auto;
      gap: 28px;
      min-height: auto;
      padding-bottom: 20px;
    }

    .hero-photo-wrap {
      position: relative;
      top: auto;
      bottom: auto;
      right: auto;
      width: 100%;
      height: clamp(280px, 46vh, 440px);
      order: 1;
      mask-image: linear-gradient(to bottom, black 75%, transparent 100%);
      -webkit-mask-image: linear-gradient(to bottom, black 75%, transparent 100%);
    }

    .hero-photo {
      object-position: 46% 25%;
    }

    .hero-center {
      order: 2;
      padding-top: 0;
    }

    .hero-content {
      max-width: 100%;
    }

    .scroll-cue {
      display: none;
    }

    .hero-bottom {
      order: 3;
    }
  }

  .fact-rail {
    max-width: var(--max-w);
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
    gap: 20px 32px;
    padding-top: 24px;
    position: relative;
  }

  .fact-rail::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: var(--line-strong);
    transform-origin: left;
    animation: rail-draw 1.1s cubic-bezier(0.16, 1, 0.3, 1) 0.3s backwards;
  }

  @keyframes rail-draw {
    0% {
      transform: scaleX(0);
      opacity: 0;
    }
    100% {
      transform: scaleX(1);
      opacity: 1;
    }
  }

  .fact-label {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(237, 228, 211, 0.75);
    margin-top: 6px;
  }
</style>
