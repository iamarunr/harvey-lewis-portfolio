---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import heroPhoto from '../assets/photos/hero-silhouette.jpg';
import commutePhoto from '../assets/photos/sunrise-road.jpg';
import comebackPhoto from '../assets/photos/portrait-bw.jpg';
import morningAfterPhoto from '../assets/photos/no-finish-arch.jpg';

const stats = [
  { n: '450 mi', l: "Big's Backyard WR, 2023" },
  { n: '2×', l: 'Badwater 135 Champion' },
  { n: '124', l: 'Ultra Races Since 1996' },
  { n: '3 mi', l: 'Daily Run-Commute to SCPA' },
];

const records = [
  {
    figure: '108 laps · 450 mi',
    event: "Big's Backyard Ultra",
    year: '2023',
    note: 'World record. 108 hours on his feet. Six runners passed 100 hours for the first time in history — Lewis was the last one standing.',
  },
  {
    figure: '85 laps · 354 mi',
    event: "Big's Backyard Ultra",
    year: '2021',
    note: 'World record at the time. Ran the final yards with a fractured right hand and told no one. "It\'s kind of like a poker game."',
  },
  {
    figure: '33 h 32 m',
    event: 'Badwater Basin → Mt. Whitney',
    year: '2020',
    note: 'World record, lowest to highest point in the contiguous U.S. — 146 miles, breaking Marshall Ulrich\'s mark that stood since 1991.',
  },
  {
    figure: '23:52 · 25:50',
    event: 'Badwater 135 — two wins',
    year: '2014 · 2021',
    note: 'Champion of "the world\'s toughest footrace," twice — the second at age 45, coming from an hour behind at mile 90.',
  },
];

const stories = [
  {
    kicker: 'The Commute',
    title: 'He runs to work. Every day.',
    body: 'After screening a climate film for his students around 2013, he promised them he\'d stop driving. Three miles each morning, backpack the size of a mini-fridge — sometimes racing the school bus.',
    photo: commutePhoto,
    alt: 'Harvey Lewis running along a road at sunrise, hills behind him',
  },
  {
    kicker: 'The Comeback',
    title: 'A broken neck, rebuilt in titanium.',
    body: 'Around 2004, surgeons reconstructed his C4–C5 vertebrae. He came back faster. "I try to encourage people not to put mental limitations on their abilities."',
    photo: comebackPhoto,
    alt: 'Black-and-white portrait of Harvey Lewis mid-race, eyes fixed ahead',
  },
  {
    kicker: 'The Morning After',
    title: '450 miles. Then back to class.',
    body: 'After 108 hours of running at Big\'s 2023, he slept in a tent, drove home to Cincinnati, and was teaching by Friday morning.',
    photo: morningAfterPhoto,
    alt: 'Harvey Lewis walking under the "There Is No Finish" arch at Big\'s Backyard Ultra, race clock past 95 hours',
  },
];
---

<Base title="Harvey Lewis — Ultrarunner & Teacher">
  <!-- ============ HERO (Option B: full-bleed photo, text bottom-left) ============ -->
  <section class="hero">
    <div class="hero-media">
      <Image
        src={heroPhoto}
        alt="Harvey Lewis running through darkness, lit only by a low shaft of sunlight"
        widths={[800, 1400, 2000, 2736]}
        sizes="100vw"
        quality={80}
        loading="eager"
      />
    </div>

    <div class="hero-content container">
      <p class="hero-eyebrow">Ultrarunner &amp; Teacher — Cincinnati, Ohio</p>
      <h1 class="hero-name">Harvey Lewis</h1>
      <p class="hero-sub">
        Two-time Badwater 135 champion. Backyard ultra world record.
      </p>
    </div>

    <div class="hero-ticker">
      <div class="container hero-ticker-row">
        {
          stats.map((s) => (
            <span class="tick">
              <strong>{s.n}</strong> {s.l}
            </span>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ============ LEDE ============ -->
  <section class="lede">
    <div class="container lede-grid">
      <div class="lede-main">
        <p class="mono-label">01 / Who he is</p>
        <p class="lede-text">
          Harvey Lewis III teaches social studies at the School for Creative
          and Performing Arts in Over-the-Rhine, Cincinnati — and holds some of
          the most demanding endurance records on Earth. He has raced ultras
          on seven continents since 1996, powered by plants since his mother's
          stroke changed everything at nineteen.
        </p>
        <a class="text-link" href="/story">Read the full story</a>
      </div>
      <div class="lede-facts">
        <p class="mono-label">Vitals</p>
        <dl class="facts">
          <div><dt>Born</dt><dd>April 13, 1976 — Wheeling, WV</dd></div>
          <div><dt>Base</dt><dd>East Walnut Hills, Cincinnati</dd></div>
          <div><dt>Teaching since</dt><dd>2006, SCPA</dd></div>
          <div><dt>Diet</dt><dd>Vegan since 2016 · vegetarian since 1996</dd></div>
          <div><dt>Team USA</dt><dd>5× IAU 24-Hour — a U.S. record</dd></div>
          <div><dt>Countries run</dt><dd>101, across seven continents</dd></div>
        </dl>
      </div>
    </div>
  </section>

  <!-- ============ RECORDS ============ -->
  <section class="records">
    <div class="container">
      <p class="mono-label">02 / The record book</p>
      <h2 class="section-title">Feats of the <em>unreasonable</em></h2>
      <div class="records-grid">
        {
          records.map((r) => (
            <article class="record-card">
              <p class="record-figure">{r.figure}</p>
              <p class="record-event">
                {r.event} <span class="record-year">{r.year}</span>
              </p>
              <p class="record-note">{r.note}</p>
            </article>
          ))
        }
      </div>
      <a class="text-link" href="/races">Every race since 1996 — the full archive</a>
    </div>
  </section>

  <!-- ============ STORY TEASERS ============ -->
  <section class="stories">
    <div class="container">
      <p class="mono-label">03 / More than miles</p>
      <div class="stories-grid">
        {
          stories.map((s) => (
            <article class="story-card">
              <div class="story-photo">
                <Image
                  src={s.photo}
                  alt={s.alt}
                  widths={[400, 640, 900]}
                  sizes="(max-width: 640px) 100vw, 33vw"
                  quality={80}
                />
              </div>
              <p class="eyebrow">{s.kicker}</p>
              <h3 class="story-title">{s.title}</h3>
              <p class="story-body">{s.body}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ============ QUOTE ============ -->
  <section class="quote">
    <div class="container">
      <blockquote>
        <p>
          “We are all capable of incredible feats. No matter your pursuits, we
          can all go so much further than we think.”
        </p>
        <cite>— Harvey Lewis, Rich Roll Podcast, 2024</cite>
      </blockquote>
    </div>
  </section>
</Base>

<style>
  /* ---------- HERO ---------- */
  .hero {
    position: relative;
    min-height: calc(100svh - 65px);
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
  }

  .hero-media {
    position: absolute;
    inset: 0;
    border-bottom: 1px solid var(--line);
    overflow: hidden;
    background: var(--bg-deep);
  }

  .hero-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 78% center;
  }

  .hero-content {
    position: relative;
    z-index: 2;
    width: 100%;
    padding-bottom: 48px;
  }

  .hero-eyebrow {
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.75);
    text-shadow: 0 0 12px rgba(0, 0, 0, 0.5);
  }

  .hero-name {
    font-family: var(--font-serif);
    font-weight: 700;
    font-size: 108px;
    line-height: 0.98;
    letter-spacing: -0.01em;
    color: #ffffff;
    text-shadow: 0 0 18px rgba(0, 0, 0, 0.45);
    margin: 20px 0 22px;
  }

  .hero-sub {
    font-size: 16px;
    line-height: 1.55;
    color: rgba(255, 255, 255, 0.75);
    text-shadow: 0 0 12px rgba(0, 0, 0, 0.5);
    max-width: 52ch;
  }

  .hero-ticker {
    position: relative;
    z-index: 2;
    background: var(--bg-deep);
  }

  .hero-ticker-row {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 48px;
    padding-top: 18px;
    padding-bottom: 18px;
  }

  .tick {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-dim);
  }

  .tick strong {
    font-weight: 700;
    color: var(--ink);
    margin-right: 6px;
  }

  /* ---------- LEDE ---------- */
  .lede {
    padding: 96px 0;
    border-bottom: 1px solid var(--line);
  }

  .lede-grid {
    display: grid;
    grid-template-columns: 1.6fr 1fr;
    gap: 64px;
    align-items: start;
  }

  .lede-text {
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: 28px;
    line-height: 1.4;
    margin: 20px 0 28px;
  }

  .facts {
    margin-top: 16px;
    border-top: 1px solid var(--line);
  }

  .facts div {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding: 12px 0;
    border-bottom: 1px solid var(--line);
  }

  .facts dt {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-dim);
    white-space: nowrap;
    padding-top: 3px;
  }

  .facts dd {
    font-size: 14px;
    text-align: right;
  }

  .text-link {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink);
    border-bottom: 1px solid var(--rust);
    padding-bottom: 3px;
  }

  .text-link:hover {
    color: var(--rust);
  }

  /* ---------- RECORDS ---------- */
  .records {
    padding: 96px 0;
    border-bottom: 1px solid var(--line);
  }

  .section-title {
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: 44px;
    line-height: 1.1;
    margin: 16px 0 48px;
  }

  .section-title em {
    font-style: italic;
    font-weight: 340;
    color: var(--rust);
  }

  .records-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    border-top: 1px solid var(--line);
    border-left: 1px solid var(--line);
    margin-bottom: 40px;
  }

  .record-card {
    padding: 32px;
    border-right: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }

  .record-figure {
    font-family: var(--font-mono);
    font-size: 30px;
    font-weight: 700;
    color: var(--rust);
  }

  .record-event {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin: 10px 0 14px;
  }

  .record-year {
    color: var(--ink-dim);
  }

  .record-note {
    font-size: 14px;
    line-height: 1.6;
    color: var(--ink-dim);
  }

  /* ---------- STORIES ---------- */
  .stories {
    padding: 96px 0;
    border-bottom: 1px solid var(--line);
  }

  .stories-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 32px;
    margin-top: 40px;
  }

  .story-photo {
    aspect-ratio: 4 / 3;
    margin-bottom: 20px;
    overflow: hidden;
    border: 1px solid var(--line);
  }

  .story-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .story-title {
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: 24px;
    line-height: 1.2;
    margin: 10px 0 12px;
  }

  .story-body {
    font-size: 14px;
    line-height: 1.65;
    color: var(--ink-dim);
  }

  /* ---------- QUOTE ---------- */
  .quote {
    padding: 112px 0;
    background: var(--bg-deep);
  }

  .quote blockquote p {
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 340;
    font-size: 36px;
    line-height: 1.3;
    max-width: 820px;
  }

  .quote cite {
    display: block;
    margin-top: 24px;
    font-family: var(--font-mono);
    font-style: normal;
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-dim);
  }

  /* ---------- Tablet < 900px ---------- */
  @media (max-width: 900px) {
    .hero-name {
      font-size: 84px;
    }
  }

  /* ---------- Mobile < 640px ---------- */
  @media (max-width: 640px) {
    .hero-media img {
      object-position: 54% center;
    }

    .hero-name {
      font-size: 54px;
    }

    .hero-ticker-row {
      gap: 10px 28px;
    }

    .lede-grid {
      grid-template-columns: 1fr;
      gap: 48px;
    }

    .lede-text {
      font-size: 22px;
    }

    .section-title {
      font-size: 32px;
    }

    .records-grid {
      grid-template-columns: 1fr;
    }

    .stories-grid {
      grid-template-columns: 1fr;
    }

    .quote blockquote p {
      font-size: 26px;
    }
  }
</style>
