    url: 'https://chasingdemocracy250.com/',
  },
  {
    year: '2026',
    outlet: 'Badwater 135',
    title: 'Harvey Lewis Logs 15th Career Badwater Finish at Age 50',
    note: 'Crossing the Mt. Whitney Portal in 25:55:41 for his 15th official finish of "the world’s toughest footrace."',
    byline: 'July 2026',
    url: 'https://www.badwater.com/',
  },
  {
    year: '2024',
    outlet: 'Newton Running / Trail Media',
    title: 'Harvey Lewis Pulls Off the "Badwater Double" — 270 Miles Across Death Valley and Back',
    note: 'After finishing the 135-mile Badwater in 36:41:22, Lewis turned around at the Mt. Whitney Portal and ran all the way back to Badwater Basin.',
    byline: 'July 2024',
