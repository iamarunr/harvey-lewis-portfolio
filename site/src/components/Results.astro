---
import races from '../data/races.json';
import selected from '../data/selected-results.json';

interface Props {
  /** How many curated rows to show. Clamped to 5–10, as in the prototype. */
  count?: number;
}

const { count = 10 } = Astro.props;
const rows = selected.slice(0, Math.max(5, Math.min(10, count)));

// The header meta is derived from races.json so it can never drift from the data.
const raceCount = races.length;
const firstYear = Math.min(...races.map((race) => race.year));
---

<section id="results">
  <div class="section-inner">
    <div class="section-head" data-reveal>
      <span>Selected results</span>
      <span>
        {raceCount} races since {firstYear} · UltraSignup, iRunFar · WR = world record at the
        time
      </span>
    </div>

    <div class="rows" data-reveal-group data-reveal-step="55">
      {
        rows.map((row) => (
          <div class="row" data-reveal>
            <span class="year">{row.year}</span>
            <span class="event">{row.event}</span>
            <span class="detail">{row.detail}</span>
            <span class:list={['place', row.win && 'is-win']}>{row.place}</span>
          </div>
        ))
      }
    </div>

    <a href="/races" class="see-all" data-reveal>All {raceCount} races since {firstYear} →</a>
  </div>
</section>

<style>
  /* Wrapping flex, not a fixed 4-track grid — a grid breaks on phones. */
  .row {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 18px;
    align-items: baseline;
    padding: 18px 6px;
    border-bottom: 1px solid rgba(237, 228, 211, 0.12);
    transition: background-color 0.15s ease;
  }

  .row:hover {
    background: rgba(237, 228, 211, 0.05);
  }

  .year {
    flex: 0 0 64px;
    font-family: var(--font-mono);
    font-size: 13px;
    color: rgba(237, 228, 211, 0.7);
  }

  .event {
    flex: 1 1 220px;
    font-weight: 500;
    font-size: 18px;
    line-height: 1.3;
  }

  .detail {
    flex: 1 1 150px;
    font-family: var(--font-mono);
    font-size: 13px;
    color: rgba(237, 228, 211, 0.78);
  }

  .place {
    flex: 0 0 112px;
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgba(237, 228, 211, 0.7);
  }

  .place.is-win {
    color: var(--rust);
  }
</style>
