---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Arrow from '../components/Arrow.astro';
import saltFlat from '../assets/photos/salt-flat.jpg';
import veganFriends from '../assets/photos/vegan-friends.jpg';
import after450 from '../assets/photos/after-450.jpg';
import students from '../assets/photos/students.jpg';
import badwaterFinishNight from '../assets/photos/badwater-finish.jpg';
import sunsetTogether from '../assets/photos/sunset-together.jpg';

type Photo = { src: ImageMetadata; alt: string; caption: string; wide?: boolean };

// Photos sit with the chapter they belong to. Most are small web exports, so they are
// shown near their native size rather than stretched.
const photos: Record<string, Photo[]> = {
  '1995–1996': [
    { src: veganFriends, alt: 'Harvey Lewis in a VEGAN shirt with Lazarus Lake and a friend at a race camp', caption: 'With Lazarus Lake, at a race camp' },
  ],
  '2006–today': [
    { src: students, alt: 'Harvey Lewis speaking to hundreds of schoolchildren outdoors', caption: 'Speaking to schoolchildren' },
  ],
  '2014–2026': [
    { src: after450, alt: 'Harvey Lewis after finishing a backyard ultra, scraped but standing', caption: 'After a backyard ultra', wide: true },
    { src: badwaterFinishNight, alt: 'Harvey Lewis crossing the Badwater 135 finish tape at night with his crew and an American flag', caption: 'Badwater 135 finish, Whitney Portal', wide: true },
  ],
  Today: [
    { src: sunsetTogether, alt: 'Harvey and Kelly at sunset on a salt flat', caption: 'Harvey and Kelly' },
  ],
};

const chapters = [
  {
    era: '1976–1995',
    title: 'Not a natural athlete.',
    paras: [
      'Harvey Lewis III was born on April 13, 1976 in Wheeling, West Virginia, and grew up in Berea, Ohio, a suburb of Cleveland. By his own account he was an unhealthy kid: fast food culture, meals heavy on meat, heartburn, and "layers of fat around my stomach."',
      'Yet something was picking at him. He explored the Pennsylvania woods as a boy, saw black bears, and loved his pets, while eating fast food without connecting the two.',
    ],
    quote: {
      text: 'I loved animals, my cat, my dog, my fish. But I didn\'t think anything and would just grab something from McDonald\'s. Something was picking at me.',
      cite: 'Great Vegan Athletes',
    },
  },
  {
    era: '1995–1996',
    title: 'His mother\'s stroke changed everything.',
    paras: [
      'When Lewis was 19, his mother, a 54-year-old nurse, suffered a sudden stroke despite no family history. The experience shook him into rethinking everything about food and health.',
      'By 1996 the transformation was underway: he went vegetarian, and that same year, at age 20, he ran his first ultramarathon, the FANS 24-Hour in Minnesota, covering 81.3 miles. He went fully vegan in 2016 and hasn\'t wavered since. He calls it "the single most important ingredient to my longevity in the sport."',
    ],
    quote: {
      text: 'When I was 19 my mother had a stroke. She was 54 years old, a nurse, and we had no family history. The nutrition was a big element that we could have done differently.',
      cite: 'Great Vegan Athletes',
    },
  },
  {
    era: 'Around 2004',
    title: 'A broken neck, rebuilt in titanium.',
    paras: [
      'Around 2004, Lewis suffered a broken neck. Neurosurgeons rebuilt his C4 and C5 vertebrae with titanium implants. Rather than ending his career, the injury catalyzed it; he returned to competition faster than before.',
    ],
    quote: {
      text: 'I was fortunate to survive, and after that event I actually have become so much faster. I try to encourage people not to put mental limitations on their abilities because you never know what you can do.',
      cite: 'WVXU, July 2014',
    },
  },
  {
    era: '2006–today',
    title: 'He promised his students. Then he kept running.',
    paras: [
      'Lewis has taught at the School for Creative and Performing Arts in Cincinnati\'s Over-the-Rhine since 2006, teaching financial literacy and American government. Around 2013, after screening a climate change documentary in his government class, he made his students a promise: he would stop driving to work.',
      'Every school day since, he has run roughly three miles from East Walnut Hills to SCPA: up Mount Adams for a sunrise view of Eden Park, down the riverside trail, through downtown\'s cobblestone alleyways, past Washington Park. His backpack is famously the size of a mini-fridge. On mornings when his students are on the bus route, he races the bus.',
      'He calls each student "a sequoia, with so much potential in front of you."',
    ],
    quote: {
      text: 'That\'s a great opportunity to show them the benefits of: I\'m 47, and … I\'m racing a bus? What the hell is going on here?',
      cite: 'iRunFar, May 2024',
    },
  },
  {
    era: '2008–2026',
    title: 'Gandhi\'s Salt March. Selma. Chasing Democracy 250.',
    paras: [
      'In 2008, Lewis earned a grant to retrace Mahatma Gandhi\'s 1930 Salt March: 241 miles from Ahmedabad to the coastal city of Dandi, India. In 2009, he ran Dr. Martin Luther King Jr.\'s Selma to Montgomery march.',
      'Afterward he met 99-year-old civil rights icon Amelia Boynton Robinson, who told him: "I believe God kept me alive 99 years so I can share my story with young people." Ever the teacher.',
      'In summer 2026, celebrating America\'s 250th anniversary, he carried this witness forward on the roads with Chasing Democracy 250, a 250-mile journey from Liberty State Park under the Statue of Liberty to the Martin Luther King Jr. Memorial in Washington, D.C. Running alongside educators and veterans over five days, he ran to illuminate the stories of marginalized communities whose struggles forged the nation.',
    ],
    quote: {
      text: 'I wanted to celebrate America’s 250th birthday by running 250 miles and highlighting the diverse communities whose struggles and triumphs have built America. I’m running to go beyond the textbook.',
      cite: 'Chasing Democracy 250, 2026',
    },
  },
  {
    era: '2018',
    title: '2,190 miles with his dad in the crew van.',
    paras: [
      'In 2018, Lewis ran the full Appalachian Trail from Springer Mountain, Georgia to Mount Katahdin, Maine in 49 days and 14 hours, averaging over 42 miles per day (one of the ten fastest completions ever at the time). His crew chief was his father, Harvey Lewis Jr. (then 78), from whom he had been estranged early in life.',
      'The journey became the award-winning documentary Like Harvey Like Son. Five days after finishing the trail, Lewis started the Badwater 135.',
    ],
  },
  {
    era: '2014–2026',
    title: 'Last man standing. Fifteen Badwaters.',
    paras: [
      'Lewis has won Badwater 135 twice: 2014 (23:52) and 2021 (25:50:23), the second at age 45 after coming from an hour behind at mile 90. In 2024, after finishing the race, he turned around and ran all the way back across Death Valley to complete the legendary 270-mile "Badwater Double." In 2026 at age 50, he logged his 15th career Badwater finish.',
      'At Big\'s Backyard Ultra he set the backyard world record twice: 85 laps (354 miles) in 2021 (finishing the final yards with a broken hand) and 108 laps (450 miles) in 2023. In 2025, he pushed further still to 111 laps (462.51 miles). And in August 2026, he completed 47 yards (195.8 miles) at Germany\'s Last Soul Ultra.',
      'After the 2023 win, he slept in a tent, drove home to Cincinnati, and was back in his classroom Friday morning. Less than 48 hours after finishing 450 miles, he ran to school. He had to go teach.',
    ],
    quote: {
      text: 'There are powers that exist to push us beyond what seems reasonable.',
      cite: 'iRunFar, November 2023',
    },
  },
  {
    era: 'Today',
    title: 'Charlie, the Flying Pig, and 101 countries.',
    paras: [
      'Lewis lives in East Walnut Hills, Cincinnati, with a rescued dog named Charlie, who runs long distances with him and eats plant-based too. He has run every Flying Pig Marathon since the race began in 1999, and has visited 101 countries across seven continents. He counts centenarian vegan runner Mike Fremont among his friends and running partners.',
      'His pre-run breakfast: granola with almond milk, chia seeds, and dragon fruit. His race fuel: squeezable chia pouches, miso soup, coconut water, beans and rice, bean burritos: "as long as it\'s vegan, I\'m happy to have it."',
    ],
  },
];
---

<Base title="Story — Harvey Lewis" description="From a broken neck to back-to-back world records: the story of Cincinnati high school teacher and ultrarunner Harvey Lewis.">
  <header class="page-head story-head">
    <div class="story-head-text">
      <h1 class="display-1">From a broken neck to the record book.</h1>
      <p class="lede">
        A Cincinnati high school teacher who has spent thirty years finding out how far a person can run,
        without ever giving up his day job.
      </p>
    </div>
    <figure class="story-plate">
      <Image src={saltFlat} alt="Harvey Lewis running across a salt flat toward a low sun" widths={[540, 800, 1080]} sizes="(max-width: 900px) 100vw, 40vw" loading="eager" fetchpriority="high" />
    </figure>
  </header>

  <div class="salt story-body">
    {
      chapters.map((c) => (
        <article class="chapter wrap">
          <div class="chapter-rail">
            <p class="chapter-era">{c.era}</p>
          </div>
          <div class="chapter-main">
            <h2 class="display-3">{c.title}</h2>
            <div class="prose chapter-prose">
              {c.paras.map((p) => <p>{p}</p>)}
            </div>
            {c.quote && (
              <blockquote class="chapter-quote">
                <p class="pull">“{c.quote.text}”</p>
                <cite class="pull-cite">Harvey Lewis · {c.quote.cite}</cite>
              </blockquote>
            )}
          </div>
          {photos[c.era] && (
            <div class="chapter-photos">
              {photos[c.era].map((ph) => (
                <figure class:list={['chapter-photo', ph.wide && 'is-wide']}>
                  <Image src={ph.src} alt={ph.alt} widths={[360, 640, 1072]} sizes="(max-width: 900px) 90vw, 340px" />
                  <figcaption>{ph.caption}</figcaption>
                </figure>
              ))}
            </div>
          )}
        </article>
      ))
    }
  </div>

  <nav class="story-next wrap sec" aria-label="Keep reading">
    <a href="/races" class="next-link">
      <span class="label dim">Next</span>
      <span class="display-2">Every race since 1996</span>
      <Arrow />
    </a>
  </nav>
</Base>

<style is:global>
  .story-head {
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
    align-items: end; gap: 40px clamp(32px, 6vw, 112px);
  }
  .story-head-text { display: grid; gap: clamp(24px, 3vw, 44px); padding-bottom: clamp(8px, 2vw, 32px); }
  .story-head .display-1 { max-width: 12ch; }
  .story-plate img { width: 100%; height: min(80svh, 900px); object-fit: cover; object-position: 50% 60%; }

  .story-body { padding: clamp(40px, 5vw, 80px) 0 var(--sec); }
  .chapter {
    display: grid;
    grid-template-columns: minmax(0, 3fr) minmax(0, 6fr) minmax(0, 3fr);
    gap: 24px clamp(24px, 4vw, 72px);
    padding-top: clamp(64px, 8vw, 128px);
  }
  .chapter + .chapter { border-top: 1px solid var(--dark-rule); margin-top: clamp(64px, 8vw, 128px); }
  .chapter-rail { position: relative; }
  .chapter-era {
    position: sticky; top: 96px;
    font-family: var(--display); font-weight: 850; text-transform: uppercase;
    font-size: clamp(28px, 2.6vw, 44px); line-height: 0.95;
  }
  .chapter-main .display-3 { max-width: 16ch; }
  .chapter-prose { margin-top: clamp(24px, 2.4vw, 36px); }
  .chapter-quote { margin-top: clamp(40px, 4vw, 64px); padding-top: 24px; border-top: 2px solid var(--dark); }
  .chapter-quote .pull { font-size: clamp(24px, 2vw, 34px); max-width: 28ch; }
  .chapter-photos { display: grid; gap: 32px; align-content: start; padding-top: 8px; }
  .chapter-photo { max-width: 340px; }
  .chapter-photo img { width: 100%; }
  .chapter-photo figcaption { margin-top: 10px; }

  .next-link {
    display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: end; gap: 8px 32px;
    text-decoration: none; padding-bottom: 24px; border-bottom: 2px solid var(--ink);
  }
  .next-link .label { grid-column: 1 / -1; }
  .next-link .arrow { width: clamp(40px, 5vw, 80px); height: clamp(40px, 5vw, 80px); stroke-width: 1.8; }
  .next-link:hover { color: var(--line); }

  @media (max-width: 900px) {
    .chapter { grid-template-columns: 1fr; }
    .chapter-era { position: static; color: var(--dark-dim); font-size: 24px; }
    .chapter-photos { grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); }
    .story-head { grid-template-columns: 1fr; }
    .story-plate { margin: 0 calc(var(--gut) * -1); }
    .story-plate img { height: 64svh; }
  }
</style>
