---
import partners from '../data/partners.json';
import reach from '../data/reach.json';
---

<section id="partners">
  <div class="section-inner">
    <h2 class="section-head" data-reveal>
      <span>Partners &amp; affiliations</span>
      <span>Verified social &amp; media reach</span>
    </h2>

    <div class="partners hairline-grid" data-reveal-group data-reveal-step="70">
      {
        partners.map((partner) => (
          <div class="partner lift" data-reveal>
            <div class="partner-kind">{partner.kind}</div>
            <div>
              <div class="partner-name">
                {partner.href ? (
                  <a
                    href={partner.href}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="partner-link"
                    aria-label={`${partner.name} (opens in a new tab)`}
                  >
                    {partner.name} <span class="partner-arrow" aria-hidden="true">↗</span>
                  </a>
                ) : (
                  partner.name
                )}
              </div>
              <div class="partner-note">{partner.note}</div>
            </div>
          </div>
        ))
      }
    </div>

    <div class="reach hairline-grid" data-reveal-group data-reveal-step="80">
      {
        reach.map((item) => (
          <div class="reach-cell" data-reveal>
            <div class="reach-value" data-count>{item.value}</div>
            <div class="reach-label">{item.label}</div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .partners {
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 340px), 1fr));
    margin-top: 40px;
  }

  .partner {
    background: var(--bg);
    padding: clamp(28px, 2.5vw, 38px) clamp(24px, 2vw, 32px);
    min-height: 150px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 20px;
  }

  .partner-kind {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-dim);
  }

  .partner-name {
    font-weight: 600;
    font-size: clamp(20px, 1.4vw, 24px);
    line-height: 1.2;
  }

  .partner-link {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    min-height: 44px;
    color: inherit;
    transition: color 0.2s ease;
  }

  .partner-link:hover {
    color: var(--rust);
  }

  .partner-arrow {
    display: inline-block;
    font-size: 15px;
    opacity: 0.7;
    transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.2s ease;
  }

  .partner-link:hover .partner-arrow {
    opacity: 1;
    transform: translate(3px, -3px);
  }

  .partner-note {
    font-size: clamp(14px, 0.95vw, 16px);
    line-height: 1.55;
    color: var(--ink-dim);
    margin-top: 8px;
  }

  .reach {
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 200px), 1fr));
    margin-top: 10px;
  }

  .reach-cell {
    background: var(--bg);
    padding: clamp(26px, 2.2vw, 34px) clamp(22px, 2vw, 30px);
  }

  .reach-value {
    font-family: var(--font-num);
    font-size: clamp(36px, 3.8vw, 54px);
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }

  .reach-label {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-dim);
    margin-top: 10px;
  }
</style>
