---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Arrow from '../components/Arrow.astro';
import talks from '../data/talks.json';
import speakingFacts from '../data/speaking-facts.json';
import site from '../data/site.json';
import { stats } from '../lib/races';
import students from '../assets/photos/students.jpg';
import after450 from '../assets/photos/after-450.jpg';

const speakingHref = `mailto:${site.enquiryEmail}?subject=${encodeURIComponent('Speaking enquiry')}`;

// What a booker needs to know before they can say yes.
const audiences = [
  {
    kind: 'Corporate teams & leadership',
    title: 'Work with no visible finish line',
    body: 'Pacing, recovery and decision-making under fatigue — argued from a 108-hour race rather than a management book. Offsites, all-hands and leadership days.',
  },
  {
    kind: 'Middle & high schools',
    title: 'Students told what they are not good at',
    body: 'He teaches full time, so he pitches to the room rather than over it. Assemblies, sports banquets and awards nights. He takes questions until they run out.',
  },
  {
    kind: 'Universities & commencements',
    title: 'The long game, before it starts',
    body: 'Thirty years of building something slowly, for an audience about to be told to move fast. Commencements, orientation weeks and athletics departments.',
  },
  {
    kind: 'Race expos & banquets',
    title: 'A field that knows the terrain',
    body: 'Fifteen Badwater finishes, five Team USA appearances, two backyard world records. Specific, technical, and honest about what went wrong.',
  },
];

const facts = [...speakingFacts, { label: 'Heard on', value: 'Rich Roll Podcast, twice (ep. 658, 812)' }];
---

<Base
  title="Speaking — Harvey Lewis"
  description="Book Harvey Lewis: keynotes for companies, schools, universities and endurance events, from a Cincinnati high school teacher who has won Badwater 135 twice."
>
  <header class="page-head sp-head">
    <div class="sp-head-text">
      <h1 class="display-2">A teacher who can tell you what the fifth day feels like.</h1>
      <p class="lede">
        Specific, unhurried, evidence first. Harvey has held rooms of ninth graders and rooms of executives with
        the same stories, and he is back in his own classroom on Monday.
      </p>
      <div class="sp-actions">
        <a href={speakingHref} class="btn btn-line btn-lg">Check a date <Arrow /></a>
        <a href="/media" class="text-link">Bio &amp; quick facts <Arrow /></a>
      </div>
    </div>
    <figure class="sp-head-photo">
      <Image src={after450} alt="Harvey Lewis after finishing a backyard ultra, scraped but standing" widths={[400, 700, 1072]} sizes="(max-width: 900px) 70vw, 30vw" loading="eager" />
      <figcaption class="dim">After a backyard ultra</figcaption>
    </figure>
  </header>

  <section class="salt wrap sec" aria-labelledby="talks-h">
    <h2 id="talks-h" class="display-2">Three talks.</h2>
    <p class="lede talks-lede">Each one adapts to your run time, from a 30-minute assembly to a full keynote.</p>
    <ol class="index talks">
      {
        talks.map((t) => (
          <li class="talk">
            <h3 class="display-3">{t.title}</h3>
            <p class="talk-meta label">{t.tag}</p>
            <p class="talk-body">{t.body}</p>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="wrap sec" aria-labelledby="aud-h">
    <h2 id="aud-h" class="display-2">Who he speaks to.</h2>
    <ul class="index audiences">
      {
        audiences.map((a) => (
          <li class="aud">
            <p class="aud-kind label">{a.kind}</p>
            <h3 class="aud-title">{a.title}</h3>
            <p class="aud-body dim">{a.body}</p>
          </li>
        ))
      }
    </ul>

    <div class="sp-facts">
      <figure class="sp-facts-photo">
        <Image src={students} alt="Harvey Lewis speaking to hundreds of schoolchildren outdoors" widths={[340, 480]} sizes="(max-width: 900px) 70vw, 340px" />
        <figcaption class="dim">Speaking to schoolchildren</figcaption>
      </figure>
      <dl class="facts">
        {
          facts.map((f) => (
            <div>
              <dt class="label">{f.label}</dt>
              <dd>{f.value}</dd>
            </div>
          ))
        }
      </dl>
    </div>

    <blockquote class="sp-quote">
      <p class="pull">“We are all capable of incredible feats. No matter your pursuits, we can all go so much further than we think.”</p>
      <cite class="pull-cite">Rich Roll Podcast, ep. 812</cite>
    </blockquote>
  </section>

  <section class="yellow wrap sec sp-close" aria-labelledby="book-h">
    <h2 id="book-h" class="display-1">He answers his own email.</h2>
    <p class="lede">{stats.count} races since {stats.firstYear}, and he still replies between class periods.</p>
    <a href={speakingHref} class="btn btn-dark btn-lg">Speaking enquiry <Arrow /></a>
  </section>
</Base>

<style is:global>
  .sp-head { grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr); align-items: end; gap: 40px clamp(32px, 6vw, 112px); }
  .sp-head-text { display: grid; gap: clamp(24px, 3vw, 40px); }
  .sp-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 16px 32px; }
  .sp-head-photo img { width: 100%; max-width: 460px; aspect-ratio: 3 / 4; object-fit: cover; object-position: 50% 30%; }
  .sp-head-photo figcaption { margin-top: 10px; }

  .talks-lede { margin-top: 20px; }
  .talks { margin-top: clamp(48px, 6vw, 96px); }
  .talk {
    display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.6fr) minmax(0, 1.2fr);
    gap: 12px clamp(24px, 4vw, 64px); align-items: baseline; padding: clamp(24px, 3vw, 40px) 0;
  }
  .talk-meta { color: var(--dark-dim); }
  .talk-body { max-width: 40ch; }

  .audiences { margin-top: clamp(48px, 6vw, 96px); }
  .aud {
    display: grid; grid-template-columns: minmax(0, 0.8fr) minmax(0, 1fr) minmax(0, 1.4fr);
    gap: 10px clamp(24px, 4vw, 64px); align-items: baseline; padding: clamp(24px, 3vw, 36px) 0;
  }
  .aud-kind { color: var(--line); }
  .aud-title { font-family: var(--text); font-weight: 500; font-size: clamp(22px, 1.8vw, 28px); line-height: 1.2; }
  .aud-body { max-width: 46ch; }

  .sp-facts {
    display: grid; grid-template-columns: minmax(0, 340px) minmax(0, 1fr); gap: 40px clamp(40px, 7vw, 128px);
    margin-top: clamp(72px, 9vw, 150px); align-items: start;
  }
  .sp-facts-photo img { width: 100%; }
  .sp-facts-photo figcaption { margin-top: 10px; }
  .facts { border-top: 2px solid var(--ink); }
  .facts div { display: grid; grid-template-columns: minmax(0, 0.5fr) minmax(0, 1fr); gap: 16px; padding: 16px 0; border-bottom: 1px solid var(--rule); }
  .facts dt { color: var(--ink-faint); padding-top: 3px; }
  .facts dd { font-size: 19px; }

  .sp-quote { margin-top: clamp(72px, 9vw, 150px); }
  .sp-quote .pull { max-width: 28ch; }

  .sp-close { display: grid; gap: clamp(24px, 3vw, 40px); justify-items: start; }
  .sp-close .display-1 { max-width: 11ch; }

  @media (max-width: 900px) {
    .sp-head, .talk, .aud, .sp-facts { grid-template-columns: 1fr; }
    .sp-head-photo { max-width: 340px; }
    .facts div { grid-template-columns: 1fr; gap: 2px; }
  }
</style>
