---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import EnquiryCards from '../components/EnquiryCards.astro';
import sunsetPortrait from '../assets/photos/sunset-portrait.jpg';

const sponsors = [
  { name: 'Brooks Running', cat: 'Footwear & apparel' },
  { name: 'InsideTracker', cat: 'Blood biomarker testing' },
  { name: 'Dream Recovery', cat: 'Sleep optimization' },
];

// Chasing Democracy 250 is an event, not an affiliation — it lives as a career
// pillar and a 2026 results row instead.
const affiliations = [
  { name: 'Team USA — IAU 24-Hour', note: '5 appearances (2012–2019) — a U.S. record' },
  { name: 'RunQuest Travel', note: 'Harvey\'s international running expedition company', url: 'https://www.runquesttravel.com' },
  { name: 'Charity Miles', note: 'Featured athlete and podcast guest', url: 'https://charitymiles.org/harvey-lewis/' },
  { name: 'Great Vegan Athletes', note: 'Profiled as a leading plant-based endurance athlete', url: 'https://www.greatveganathletes.com/harvey-lewis-ultramarathon-runner/' },
];

const socials = [
  { label: 'Instagram', handle: '@harveylewisultrarunner', url: 'https://www.instagram.com/harveylewisultrarunner' },
  { label: 'Chasing Democracy', handle: '@chasingdemocracy250', url: 'https://www.instagram.com/chasingdemocracy250' },
  { label: 'Facebook', handle: '@harveylewisultrarunner', url: 'https://www.facebook.com/harveylewisultrarunner' },
  { label: 'X / Twitter', handle: '@harveylewisruns', url: 'https://twitter.com/harveylewisruns' },
  { label: 'YouTube', handle: 'Harvey and Kelly', url: 'https://www.youtube.com/@HarveyandKelly' },
];
---

<Base title="Contact — Harvey Lewis" description="Speaking, sponsorship, and media inquiries for ultrarunner and teacher Harvey Lewis.">
  <section class="contact-hero">
    <div class="container contact-hero-grid" data-reveal-group data-reveal-step="100">
      <div data-reveal>
        <p class="eyebrow">Contact</p>
        <h1 class="contact-title">Speaking, sponsorship, <em>and media.</em></h1>
        <p class="contact-sub">
          Harvey speaks about endurance, mental limits, plant-based performance,
          and education. Pick the route that fits below — or reach him through his
          social channels.
        </p>
      </div>
      <div class="contact-portrait" data-reveal>
        <Image
          src={sunsetPortrait}
          alt="Harvey Lewis standing arms crossed on a road at dusk, wooded hills behind him"
          widths={[400, 640]}
          sizes="(max-width: 640px) 100vw, 33vw"
          quality={80}
        />
      </div>
    </div>
  </section>

  <section class="enquiries">
    <div class="container">
      <EnquiryCards />
    </div>
  </section>

  <section class="contact-body">
    <div class="container contact-grid" data-reveal-group data-reveal-step="120">
      <div>
        <p class="mono-label">Reach out</p>
        <ul class="social-list">
          {
            socials.map((s) => (
              <li>
                <a class="social-row" href={s.url} target="_blank" rel="noopener noreferrer">
                  <span class="social-label">{s.label}</span>
                  <span class="social-handle">{s.handle} <span aria-hidden="true">↗</span></span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <p class="mono-label">Sponsors</p>
        <ul class="plain-list">
          {
            sponsors.map((s) => (
              <li class="plain-row">
                <span class="plain-name">{s.name}</span>
                <span class="plain-note">{s.cat}</span>
              </li>
            ))
          }
        </ul>

        <p class="mono-label affil-label">Affiliations</p>
        <ul class="plain-list">
          {
            affiliations.map((a) => (
              <li class="plain-row">
                {a.url ? (
                  <a class="plain-name linked" href={a.url} rel="noopener">{a.name}</a>
                ) : (
                  <span class="plain-name">{a.name}</span>
                )}
                <span class="plain-note">{a.note}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>
</Base>

<style>
  .enquiries {
    padding-bottom: 8px;
  }

  .contact-hero {
    padding: 96px 0 72px;
    border-bottom: 1px solid var(--line);
  }

  .contact-hero-grid {
    display: grid;
    grid-template-columns: 1.6fr 1fr;
    gap: 56px;
    align-items: end;
  }

  .contact-portrait {
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border: 1px solid var(--line);
  }

  .contact-portrait img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .contact-title {
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: 64px;
    line-height: 1.03;
    letter-spacing: -0.01em;
    margin: 18px 0 22px;
  }

  .contact-title em {
    font-style: italic;
    font-weight: 340;
    color: var(--rust);
  }

  .contact-sub {
    font-size: 17px;
    line-height: 1.6;
    color: var(--ink-dim);
    max-width: 540px;
  }

  .contact-body {
    padding: 80px 0 112px;
  }

  .contact-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 64px;
    align-items: start;
  }

  .social-list {
    list-style: none;
    margin-top: 20px;
    border-top: 1px solid var(--line-strong);
  }

  .social-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 16px;
    padding: 18px 0;
    border-bottom: 1px solid var(--line);
  }

  .social-row:hover .social-handle {
    color: var(--rust);
  }

  .social-label {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-dim);
  }

  .social-handle {
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: 20px;
    color: var(--ink);
    word-break: break-word;
    min-width: 0;
    text-align: right;
  }

  .plain-list {
    list-style: none;
    margin-top: 20px;
    border-top: 1px solid var(--line-strong);
  }

  .plain-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 20px;
    padding: 14px 0;
    border-bottom: 1px solid var(--line);
  }

  .plain-name {
    font-size: 15px;
    font-weight: 600;
    color: var(--ink);
    white-space: nowrap;
  }

  .plain-name.linked {
    border-bottom: 1px solid var(--rust);
    padding-bottom: 2px;
  }

  .plain-name.linked:hover {
    color: var(--rust);
  }

  .plain-note {
    font-size: 13px;
    color: var(--ink-dim);
    text-align: right;
  }

  .affil-label {
    margin-top: 40px;
  }

  @media (max-width: 640px) {
    .contact-hero {
      padding: 64px 0 56px;
    }

    .contact-title {
      font-size: 38px;
    }

    .contact-hero-grid {
      grid-template-columns: 1fr;
      gap: 36px;
    }

    .contact-grid {
      grid-template-columns: 1fr;
      gap: 48px;
    }

    .social-row {
      flex-direction: column;
      align-items: flex-start;
      gap: 4px;
    }

    .social-handle {
      font-size: 18px;
      text-align: left;
    }

    .plain-row {
      flex-direction: column;
      align-items: flex-start;
      gap: 4px;
    }

    .plain-note {
      text-align: left;
    }
  }
</style>
