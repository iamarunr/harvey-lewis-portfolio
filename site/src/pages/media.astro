    url: 'https://plantbasednews.org/culture/sport/vegan-athlete-worlds-toughest-race/',
  },
  {
    year: '2020',
    outlet: 'Cincinnati Enquirer',
    title: '\'Everything Is About the Mental Strength.\' Local Runner Breaks 29-Year-Old World Record',
    note: 'Badwater Basin to Mt. Whitney in 33:32, breaking Marshall Ulrich\'s 1991 mark.',
    byline: 'Madeline Mitchell · Aug 14, 2020',
    url: 'https://www.cincinnati.com/story/news/2020/08/14/cincinnati-runner-breaks-world-record-runs-lowest-highest-points-u-s/3373809001/',
  },
  {
    year: '2020',
    outlet: 'CityBeat Cincinnati',
    title: 'A Look Inside the Life of Cincinnati Ultramarathon Runner and Educator Harvey Lewis',
    note: 'An immersive profile as CityBeat ran the morning commute with him.',
    byline: 'Nov 2020',
    url: 'https://www.citybeat.com/cincinnati/a-look-inside-the-life-of-cincinnati-ultramarathon-runner-and-educator-harvey-lewis/Slideshow/12233155',
  },
  {
    year: '2020',
    outlet: 'CityBeat Cincinnati',
    title: 'SCPA Teacher Harvey Lewis Is Topic of New Athletic Documentary \'Like Harvey Like Son\'',
    note: 'Documentary preview ahead of the Mariemont Theatre premiere.',
    byline: 'Nov 2020',
    url: 'https://www.citybeat.com/arts/cincinnati-ultramarathon-runner-and-scpa-teacher-harvey-lewis-is-topic-of-new-athletic-documentary-like-harvey-like-son-12169662/',
  },
  {
    year: '2018',
    outlet: 'Cincinnati Enquirer',
    title: 'Cincinnati Teacher Ran 2,198 Miles Under 50 Days',
    note: 'The Appalachian Trail journey, documented as it happened.',
    byline: 'Jul 19, 2018',
    url: 'https://www.cincinnati.com/story/news/2018/07/19/cincinnati-teacher-ran-2-198-miles-under-50-days/799932002/',
  },
  {
    year: '2014',
    outlet: 'WVXU (Cincinnati Public Radio)',
    title: 'SCPA Teacher Wins Badwater Race',
    note: 'The first Badwater win, and the broken-neck story in his own words.',
    byline: 'Jul 22, 2014',
    url: 'https://www.wvxu.org/sports/2014-07-22/scpa-teacher-wins-badwater-race',
  },
  {
    year: '1999',
    outlet: 'Cincinnati Enquirer',
    title: 'Finishing Strong',
    note: 'The earliest known press mention, from the year the Flying Pig streak began.',
    byline: 'May 10, 1999',
    url: null,
  },
];
---

<Base
  title="Media & Press — Harvey Lewis"
  description="The award-winning documentary, press coverage from 1999 to today, podcasts, video features and quick facts on ultrarunner and teacher Harvey Lewis."
>
  <header class="page-head">
    <h1 class="display-1">Films, podcasts and headlines.</h1>
    <p class="lede">
      Coverage from 1999 to today, and everything a journalist needs on deadline. For interviews, write to
      <a class="inline-link" href={mediaHref}>{site.enquiryEmail}</a>.
    </p>
  </header>

  <section class="salt wrap sec doc" aria-labelledby="doc-h">
    <figure class="doc-poster">
      <Image src={poster} alt="Two runners on a Death Valley highway wearing shirts reading Your Thoughts Are The Architects Of Your Destiny" widths={[480, 720, 1024]} sizes="(max-width: 900px) 90vw, 40vw" />
    </figure>
    <div class="doc-body">
      <p class="doc-award label"><span aria-hidden="true" class="doc-mark"></span>Best Feature Film · Woodbury Film Festival, 2019</p>
      <h2 id="doc-h" class="display-2">Like Harvey Like Son</h2>
      <div class="prose doc-prose">
        <p>
          In 2018 Harvey Lewis III ran the 2,190-mile Appalachian Trail in 49 days and 14 hours. His crew chief
          was his father, Harvey Lewis Jr., then 78, from whom he had been estranged early in life. Both men are
          named Harvey Lewis, and the journey from Georgia to Maine is as much a reconciliation as a record attempt.
        </p>
      </div>
      <dl class="doc-facts">
        <div><dt class="label">Director</dt><dd>Rudy Harris Jr.</dd></div>
        <div><dt class="label">Producers</dt><dd>TJ Bitter, Mike Trimpe, Rudy Harris Jr.</dd></div>
        <div><dt class="label">Premiere</dt><dd>Mariemont Theatre, Cincinnati · Nov 2020</dd></div>
        <div><dt class="label">Streaming</dt><dd>Amazon Prime Video</dd></div>
      </dl>
      <div class="doc-links">
        <a class="text-link" href="https://vimeo.com/383788991" target="_blank" rel="noopener noreferrer">Watch the trailer <Arrow class="ne" /><span class="visually-hidden">(opens in a new tab)</span></a>
        <a class="text-link" href="https://www.likeharveylikeson.com/" target="_blank" rel="noopener noreferrer">Film website <Arrow class="ne" /><span class="visually-hidden">(opens in a new tab)</span></a>
      </div>
    </div>
  </section>

  <section class="wrap sec kit" aria-labelledby="kit-h">
    <h2 id="kit-h" class="display-2">Quick facts.</h2>
    <div class="kit-grid">
      <ul class="index kit-facts">
        {mediaKit.quickFacts.map((f) => <li>{f}</li>)}
      </ul>
      <div class="kit-side">
        <table class="reach">
          <caption class="label">Audience</caption>
          <tbody>
            {reach.map((r) => (
              <tr><th scope="row">{r.label}</th><td class="num">{r.value}</td></tr>
            ))}
          </tbody>
        </table>
        <p class="kit-note dim">Short and long bio, high-resolution photography and a speaking one-sheet are sent on request, usually the same day.</p>
        <a href={kitHref} class="btn btn-line">Request the media kit <Arrow /></a>
      </div>
    </div>
  </section>

  <section class="salt wrap sec" aria-labelledby="press-h">
    <h2 id="press-h" class="display-2">In the press.</h2>
    <ol class="index press">
      {
        articles.map((a) => (
          <li class="press-item">
            <span class="press-year num">{a.year}</span>
            <div>
              <p class="label press-outlet">{a.outlet}</p>
              <h3 class="press-title">
                {a.url ? (
                  <a href={a.url} target="_blank" rel="noopener noreferrer">{a.title}<span class="visually-hidden"> (opens in a new tab)</span></a>
                ) : (
                  a.title
                )}
              </h3>
              <p class="press-note">{a.note}</p>
              <p class="press-by label">{a.byline}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="wrap sec" aria-labelledby="air-h">
    <div class="air-grid">
      <div>
        <h2 id="air-h" class="display-2">On air.</h2>
        <ul class="index listen">
          {
            podcasts.map((p) => (
              <li>
                <a href={p.url} target="_blank" rel="noopener noreferrer">
                  <span class="label listen-show">{p.show} · {p.date}</span>
                  <span class="listen-title">{p.ep}</span>
                  <Arrow class="ne" />
                  <span class="visually-hidden">(opens in a new tab)</span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
      <div>
        <h2 class="display-2">On camera.</h2>
        <ul class="index listen">
          {
            videos.map((v) => (
              <li>
                <a href={v.url} target="_blank" rel="noopener noreferrer">
                  <span class="label listen-show">{v.sub}</span>
                  <span class="listen-title">{v.title}</span>
                  <Arrow class="ne" />
                  <span class="visually-hidden">(opens in a new tab)</span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <section class="yellow wrap sec media-close" aria-labelledby="deadline-h">
    <h2 id="deadline-h" class="display-1">On deadline?</h2>
    <p class="lede">Verified race results, photography and interviews, turned around quickly.</p>
    <a href={mediaHref} class="btn btn-dark btn-lg">Media enquiry <Arrow /></a>
  </section>
</Base>

<style is:global>
  .arrow.ne { transform: rotate(-45deg); }
  a:hover > .arrow.ne { transform: rotate(-45deg) translateX(4px); }

  .doc { display: grid; grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr); gap: 40px clamp(40px, 7vw, 128px); align-items: start; }
  .doc-poster img { width: 100%; max-width: 520px; }
  .doc-body { display: grid; gap: clamp(20px, 2.4vw, 32px); }
  .doc-award { display: flex; align-items: center; gap: 10px; }
  .doc-mark { width: 12px; height: 12px; background: var(--line); box-shadow: inset 0 0 0 1.5px var(--dark); }
  .doc-facts { border-top: 2px solid var(--dark); }
  .doc-facts div { display: grid; grid-template-columns: 9em minmax(0, 1fr); gap: 16px; padding: 12px 0; border-bottom: 1px solid var(--dark-rule); }
  .doc-facts dt { color: var(--dark-dim); padding-top: 3px; }
  .doc-links { display: flex; flex-wrap: wrap; gap: 8px 32px; }

  .kit-grid { display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr); gap: 48px clamp(40px, 7vw, 128px); margin-top: clamp(48px, 6vw, 96px); align-items: start; }
  .kit-facts li { padding: 14px 0; font-size: clamp(19px, 1.4vw, 23px); }
  .kit-side { display: grid; gap: 24px; justify-items: start; }
  .reach { width: 100%; border-collapse: collapse; }
  .reach caption { text-align: left; color: var(--ink-faint); padding-bottom: 10px; border-bottom: 2px solid var(--ink); }
  .reach th, .reach td { padding: 12px 0; border-bottom: 1px solid var(--rule); text-align: left; font-weight: 400; }
  .reach td { text-align: right; font-family: var(--display); font-weight: 800; font-size: 26px; }
  .kit-note { max-width: 40ch; font-size: 17px; }

  .press { margin-top: clamp(48px, 6vw, 96px); }
  .press-item { display: grid; grid-template-columns: 6em minmax(0, 1fr); gap: 16px clamp(24px, 4vw, 64px); padding: clamp(20px, 2.4vw, 32px) 0; }
  .press-year { font-family: var(--display); font-weight: 850; font-size: clamp(28px, 2.6vw, 40px); line-height: 1; }
  .press-outlet { color: var(--dark-dim); }
  .press-title { margin-top: 6px; font-family: var(--text); font-weight: 560; font-size: clamp(21px, 1.7vw, 27px); line-height: 1.25; max-width: 40ch; text-wrap: balance; }
  .press-title a { text-decoration-thickness: 1.5px; text-underline-offset: 5px; text-decoration-color: var(--dark-rule); }
  .press-title a:hover { text-decoration-color: currentColor; }
  .press-note { margin-top: 8px; color: var(--dark-dim); max-width: 60ch; font-size: 18px; }
  .press-by { margin-top: 8px; color: var(--dark-dim); font-size: 13px; }

  .air-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 72px clamp(40px, 6vw, 112px); }
  .listen { margin-top: clamp(32px, 4vw, 56px); }
  .listen a { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 4px 20px; padding: 18px 0; text-decoration: none; }
  .listen-show { color: var(--ink-faint); font-size: 13px; }
  .listen-title { grid-column: 1; font-size: 19px; line-height: 1.35; }
  .listen .arrow { grid-column: 2; grid-row: 1 / span 2; align-self: center; color: var(--line); }
  .listen a:hover .listen-title { color: var(--line); }

  .media-close { display: grid; gap: clamp(24px, 3vw, 40px); justify-items: start; }

  @media (max-width: 900px) {
    .doc, .kit-grid, .air-grid { grid-template-columns: 1fr; }
    .press-item { grid-template-columns: 1fr; gap: 4px; }
    .doc-facts div { grid-template-columns: 1fr; gap: 2px; }
  }
</style>
