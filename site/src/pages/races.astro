---
import Base from '../layouts/Base.astro';
import Arrow from '../components/Arrow.astro';
import YearsChart from '../components/YearsChart.astro';
import races from '../data/races.json';
import { raceId, raceKind, raceName, racePlace, raceResult, stats } from '../lib/races';

const years = [...new Set(races.map((r) => r.year))].sort((a, b) => b - a);
const bigsStarts = races.filter((r) => r.race.startsWith("Big Dog's Backyard")).length;

const highlights = [
  {
    event: "Big's Backyard Ultra",
    detail: `${bigsStarts} starts · 2 wins, both world records at the time`,
    rows: [
      { y: '2025', r: '111 laps · 462.5 mi', p: '3rd' },
      { y: '2023', r: '108 laps · 450.0 mi', p: '1st — World Record' },
      { y: '2021', r: '85 laps · 354.2 mi', p: '1st — World Record' },
      { y: '2024', r: '76 laps · 316.7 mi', p: '4th' },
      { y: '2017', r: '58 laps · 241.7 mi', p: '2nd — "the assist"' },
    ],
  },
  {
    event: 'Badwater 135',
    detail: '15 finishes since 2011 · 2 wins · 5 podiums · 270 mi Double',
    rows: [
      { y: '2026', r: '25:55:41', p: '11th — 15th finish' },
      { y: '2024', r: '270 mi Badwater Double', p: 'Turnaround Finish' },
      { y: '2021', r: '25:50:23', p: '1st' },
      { y: '2014', r: '23:52:55', p: '1st' },
      { y: '2016', r: '23:40:52', p: '2nd' },
    ],
  },
  {
    event: 'IAU 24-Hour World Championship',
    detail: '5 Team USA appearances — a U.S. record',
    rows: [
      { y: '2019', r: '160.3 mi — Brive-la-Gaillarde', p: '14th' },
      { y: '2015', r: '158.4 mi — Turin', p: '9th' },
      { y: '2012', r: '148.6 mi — Katowice', p: '22nd' },
      { y: '2017', r: '144.2 mi — Belfast', p: '48th' },
    ],
  },
  {
    event: 'The Long Way Round',
    detail: 'Expeditions & iconic journeys',
    rows: [
      { y: '2026', r: 'Chasing Democracy 250 · 250 mi NYC→DC', p: 'Lead Runner' },
      { y: '2026', r: 'Last Soul Ultra (Germany) · 47 laps / 195.8 mi', p: '14th' },
      { y: '2020', r: 'Badwater Basin → Mt. Whitney · 33:32', p: 'World Record' },
      { y: '2018', r: 'Appalachian Trail · 49d 14h', p: 'Top-10 fastest ever' },
      { y: '2008', r: "Gandhi's Salt March · 241 mi", p: 'Commemorative' },
    ],
  },
];
---

<Base
  title="Races & Records — Harvey Lewis"
  description={`Every race Harvey Lewis has run since ${stats.firstYear}: ${stats.count} results and ${stats.wins} wins, from the FANS 24-Hour to two backyard world records at Big's Backyard Ultra.`}
>
  <header class="page-head">
    <h1 class="display-1">Every race since {stats.firstYear}.</h1>
    <p class="lede">
      {stats.count} results, {stats.wins} wins and {stats.podiums} podiums, one mark each. Point at a mark to read
      it, or click to find it in the archive below.
    </p>
  </header>

  <section class="wrap races-chart" aria-label="All results by year">
    <YearsChart linked />
  </section>

  <section class="salt wrap sec" aria-labelledby="ledgers-h">
    <h2 id="ledgers-h" class="display-2 ledgers-title">Where the records were set.</h2>
    <div class="ledgers">
      {
        highlights.map((h) => (
          <article class="ledger">
            <h3 class="display-3">{h.event}</h3>
            <p class="ledger-detail">{h.detail}</p>
            <table class="ledger-table">
              <caption class="visually-hidden">{h.event} results</caption>
              <tbody>
                {h.rows.map((row) => (
                  <tr>
                    <th scope="row" class="num">{row.y}</th>
                    <td class="num">{row.r}</td>
                    <td class:list={['ledger-place', /1st|World Record/.test(row.p) && 'is-record']}>{row.p}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </article>
        ))
      }
    </div>
  </section>

  <section class="wrap sec archive" aria-labelledby="archive-h">
    <div class="archive-head">
      <h2 id="archive-h" class="display-2">The archive.</h2>
      <p class="lede">From UltraSignup. Fixed-time races show miles; fixed-distance races show elapsed time.</p>
    </div>

    <div class="filters" role="group" aria-label="Filter races">
      <button type="button" class="filter" data-filter="all" aria-pressed="true">All <span class="num">{stats.count}</span></button>
      <button type="button" class="filter" data-filter="win" aria-pressed="false">Wins <span class="num">{stats.wins}</span></button>
      <button type="button" class="filter" data-filter="podium" aria-pressed="false">Podiums <span class="num">{stats.podiums}</span></button>
    </div>

    <table class="archive-table">
      <caption class="visually-hidden">All races, newest first</caption>
      <thead>
        <tr><th scope="col">Date</th><th scope="col">Race</th><th scope="col">Result</th><th scope="col">Place</th></tr>
      </thead>
      {
        years.map((year) => (
          <tbody data-year={year}>
            <tr class="year-row"><th colspan="4" scope="rowgroup">{year}</th></tr>
            {races
              .filter((r) => r.year === year)
              .map((r) => (
                <tr id={raceId(r)} class={`race race-${raceKind(r)}`} data-kind={raceKind(r)}>
                  <td class="num race-date">{r.date.slice(5).replace('-', '.')}</td>
                  <td class="race-name">{raceName(r)}<span class="race-sub">{r.race.split(' - ')[1] ?? ''}</span></td>
                  <td class="num">{raceResult(r)}</td>
                  <td class="num race-place">{racePlace(r)}</td>
                </tr>
              ))}
          </tbody>
        ))
      }
    </table>
    <p class="archive-empty" hidden data-empty>No races match this filter.</p>
  </section>

  <nav class="wrap sec races-next" aria-label="Keep reading">
    <a href="/story" class="text-link">The story behind the results <Arrow /></a>
  </nav>
</Base>

<script>
  const filters = [...document.querySelectorAll<HTMLButtonElement>('[data-filter]')];
  const rows = [...document.querySelectorAll<HTMLTableRowElement>('tr[data-kind]')];
  const groups = [...document.querySelectorAll<HTMLTableSectionElement>('tbody[data-year]')];
  const empty = document.querySelector<HTMLElement>('[data-empty]');

  const apply = (mode: string) => {
    rows.forEach((row) => {
      const k = row.dataset.kind;
      row.hidden = !(mode === 'all' || k === mode || (mode === 'podium' && k === 'win'));
    });
    let any = false;
    groups.forEach((g) => {
      const visible = g.querySelector('tr[data-kind]:not([hidden])') !== null;
      g.hidden = !visible;
      any ||= visible;
    });
    if (empty) empty.hidden = any;
  };

  filters.forEach((btn) =>
    btn.addEventListener('click', () => {
      filters.forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
      apply(btn.dataset.filter ?? 'all');
    }),
  );

  // A jump from the chart always lands on a visible row.
  const reveal = () => {
    const target = location.hash && document.querySelector<HTMLElement>(location.hash);
    if (!target || !target.matches('tr[data-kind]')) return;
    if (target.hidden) {
      filters.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.filter === 'all')));
      apply('all');
      target.scrollIntoView({ block: 'center' });
    }
    target.classList.remove('is-target');
    void target.offsetWidth;
    target.classList.add('is-target');
  };
  window.addEventListener('hashchange', reveal);
  reveal();
</script>

<style is:global>
  .races-chart { padding-bottom: clamp(72px, 9vw, 140px); }

  .ledgers-title { max-width: 14ch; }
  .ledgers {
    display: grid; grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(56px, 6vw, 96px) clamp(32px, 5vw, 96px);
    margin-top: clamp(56px, 7vw, 110px);
  }
  .ledger { border-top: 2px solid var(--dark); padding-top: 20px; }
  .ledger-detail { margin-top: 10px; color: var(--dark-dim); font-size: 17px; }
  .ledger-table { width: 100%; border-collapse: collapse; margin-top: 24px; }
  .ledger-table th, .ledger-table td {
    text-align: left; padding: 10px 0; border-bottom: 1px solid var(--dark-rule); vertical-align: baseline;
    font-family: var(--display); font-weight: 600; font-size: 18px;
  }
  .ledger-table th { width: 4.2em; font-weight: 750; }
  .ledger-place { text-align: right !important; color: var(--dark-dim); }
  .ledger-place.is-record { color: var(--dark); font-weight: 800 !important; }
  .ledger-place.is-record::before {
    content: ''; display: inline-block; width: 10px; height: 10px; margin-right: 8px; background: var(--line);
    box-shadow: inset 0 0 0 1.5px var(--dark);
  }

  .archive-head { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 24px 64px; align-items: end; }
  .filters { display: flex; flex-wrap: wrap; gap: 8px; margin-top: clamp(40px, 5vw, 72px); }
  .filter {
    display: inline-flex; align-items: center; gap: 10px; min-height: 44px; padding: 0 16px;
    background: transparent; border: 1.5px solid var(--rule); cursor: pointer;
    font-family: var(--display); font-weight: 700; font-size: 17px; letter-spacing: 0.05em; text-transform: uppercase;
    color: var(--ink-dim); transition: color 0.2s, border-color 0.2s, background-color 0.2s;
  }
  .filter:hover { color: var(--ink); border-color: var(--ink-faint); }
  .filter[aria-pressed='true'] { background: var(--line); border-color: var(--line); color: var(--dark); }

  .archive-table { width: 100%; border-collapse: collapse; margin-top: 32px; }
  .archive-table thead th {
    text-align: left; padding: 12px 0; border-bottom: 2px solid var(--ink);
    font-family: var(--display); font-weight: 650; font-size: 14px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-faint);
  }
  .archive-table thead th:nth-child(n + 3), .archive-table td:nth-child(n + 3) { text-align: right; }
  .year-row th {
    text-align: left; padding: 36px 0 10px;
    font-family: var(--display); font-weight: 850; font-size: clamp(28px, 2.6vw, 40px); line-height: 1;
    border-bottom: 1px solid var(--ink-faint);
  }
  .race td {
    padding: 12px 0; border-bottom: 1px solid var(--rule); vertical-align: baseline;
    font-family: var(--display); font-weight: 600; font-size: 18px;
  }
  .race td + td { padding-left: 16px; }
  .race-date { width: 4.5em; color: var(--ink-faint); }
  .race-name { font-family: var(--text) !important; font-weight: 450 !important; font-size: 18px !important; }
  .race-sub { display: block; font-family: var(--display); font-weight: 600; font-size: 14px; letter-spacing: 0.04em; text-transform: uppercase; color: var(--ink-faint); margin-top: 2px; }
  .race-place { width: 4.5em; color: var(--ink-dim); }
  .race-win .race-place { color: var(--line); font-weight: 800; }
  .race-dnf td { color: var(--ink-faint); }
  .race { scroll-margin-top: 30vh; }
  .race.is-target { animation: target-flash 2.4s var(--ease); }
  @keyframes target-flash { 0%, 30% { background: rgba(242, 194, 48, 0.22); } 100% { background: transparent; } }
  .archive-empty { margin-top: 32px; color: var(--ink-dim); }

  @media (max-width: 900px) {
    .ledgers, .archive-head { grid-template-columns: 1fr; }
    .archive-table thead { display: none; }
    .race { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 2px 16px; padding: 12px 0; border-bottom: 1px solid var(--rule); }
    .race td { border: 0; padding: 0 !important; }
    .race-date { grid-column: 1 / -1; font-size: 14px !important; }
    .race-name { grid-column: 1; grid-row: 2 / span 2; }
    .race td:nth-child(3) { grid-column: 2; grid-row: 2; }
    .race-place { grid-column: 2; grid-row: 3; width: auto; }
    .race[hidden] { display: none; }
  }
</style>
