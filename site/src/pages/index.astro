---
import Onepage from '../layouts/Onepage.astro';
import Hero from '../components/Hero.astro';
import Intro from '../components/Intro.astro';
import PhotoBand from '../components/PhotoBand.astro';
import Marquee from '../components/Marquee.astro';
import Results from '../components/Results.astro';
import Speaking from '../components/Speaking.astro';
import Partners from '../components/Partners.astro';
import MediaKit from '../components/MediaKit.astro';
import Contact from '../components/Contact.astro';
import SiteFooter from '../components/SiteFooter.astro';
---

<Onepage title="Harvey Lewis — ultrarunner & high school teacher">
  <Hero />
  <Intro />
  <PhotoBand />
  <Marquee
    items={[
      'Badwater 135 champion 2014',
      'Badwater 135 champion 2021',
      "Big's Backyard Ultra 450 miles",
      '108 hours without sleep',
      'Team USA · five appearances',
      'Appalachian Trail · 49 days',
      'Vegan since 1998',
      'Cincinnati Public Schools',
    ]}
  />
  <Results count={5} />
  <Speaking />
  <Partners />
  <MediaKit showPhotoGrid={false} />
  <Contact />
  <SiteFooter />
</Onepage>
