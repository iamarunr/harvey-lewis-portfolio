---
import { Image } from 'astro:assets';
import mediaKit from '../data/media-kit.json';
import site from '../data/site.json';

import badwaterDawn from '../assets/photos/badwater-dawn.jpg';
import forestRun from '../assets/photos/forest-run.jpg';
import desertRoadPair from '../assets/photos/desert-road-pair.jpg';
import noFinishArch from '../assets/photos/no-finish-arch.jpg';
import bandanaArch from '../assets/photos/bandana-arch.jpg';
import sunsetPortrait from '../assets/photos/sunset-portrait.jpg';

interface Props {
  /** Render the six-image press grid. Off for a text-only media kit. */
  showPhotoGrid?: boolean;
}

const { showPhotoGrid = true } = Astro.props;

const gallery = [
  { src: badwaterDawn, alt: 'Harvey Lewis running across Badwater Basin at dawn with desert mountains behind' },
  { src: forestRun, alt: 'Harvey Lewis trail running along a sunlit woodland path during training' },
  { src: desertRoadPair, alt: 'Harvey Lewis and pacer striding down a two-lane Death Valley highway' },
  { src: noFinishArch, alt: 'Harvey Lewis passing beneath the There Is No Finish arch at Big’s Backyard Ultra' },
  { src: bandanaArch, alt: 'Harvey Lewis wearing his signature bandana celebrating at the race arch' },
  { src: sunsetPortrait, alt: 'Harvey Lewis portrait at sunset on a quiet road overlooking wooded hills' },
];
---

<section id="media" class="band-deep">
  <div class="section-inner">
    <div class="eyebrow">Media kit</div>
    <h2 data-reveal>Everything a deadline needs</h2>

    <div class="panels hairline-grid" data-reveal-group data-reveal-step="100">
      <div class="panel">
        <div class="panel-title">Quick facts</div>
        <div class="panel-list">
          {mediaKit.quickFacts.map((fact) => <div>{fact}</div>)}
        </div>
      </div>

      <div class="panel">
        <div class="panel-title">Press</div>
        <div class="panel-list">
          {mediaKit.press.map((item) => <div>{item}</div>)}
        </div>
      </div>

      <div class="panel">
        <div class="panel-title">Downloads</div>
        <div class="downloads">
          {
            mediaKit.downloads.map((download) => {
              // Until the real asset exists, the row requests it by email rather than
              // pointing at a dead anchor. Set `file` in media-kit.json and the same
              // row becomes a genuine download with no further changes.
              const ready = Boolean(download.file);
              const href = ready
                ? download.file
                : `mailto:${site.enquiryEmail}?subject=${encodeURIComponent(
                    `Media request — ${download.label}`
                  )}`;

              return (
                <a
                  href={href}
                  class="download"
                  download={ready ? '' : undefined}
                  aria-label={
                    ready
                      ? `Download ${download.label} (${download.format})`
                      : `Request ${download.label} by email (${download.format})`
                  }
                >
                  <span class="download-label">{download.label}</span>
                  <span class="format">{ready ? download.format : `Request · ${download.format}`}</span>
                </a>
              );
            })
          }
        </div>
        <p class="downloads-note">Sent by return email, usually same day.</p>
      </div>
    </div>

    {
      showPhotoGrid && (
        <>
          <div class="gallery" data-reveal-group data-reveal-step="70">
            {gallery.map((photo) => (
              <div class="photo-cell">
                <Image
                  src={photo.src}
                  alt={photo.alt}
                  widths={[320, 640]}
                  sizes="(max-width: 640px) 90vw, 320px"
                  loading="lazy"
                />
              </div>
            ))}
          </div>
          <div class="credit">{site.photoCredit}</div>
        </>
      )
    }

    <div class="media-links" data-reveal>
      <a href="/media" class="see-all">Full media kit →</a>
      <a href="/media#press" class="see-all">Press archive →</a>
    </div>
  </div>
</section>

<style>
  h2 {
    margin: 20px 0 40px;
    font-weight: 600;
    font-size: clamp(32px, 3.6vw, 56px);
    line-height: 1.08;
    letter-spacing: -0.02em;
  }

  .panels {
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 340px), 1fr));
  }

  .panel {
    background: var(--bg-deep);
    padding: clamp(28px, 2.5vw, 38px) clamp(24px, 2vw, 32px);
  }

  .panel-title {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--rust);
  }

  .panel-list {
    margin-top: 20px;
    font-size: clamp(15px, 1.05vw, 17px);
    line-height: 1.85;
    color: var(--ink-subtle);
  }

  .downloads {
    margin-top: 16px;
    display: flex;
    flex-direction: column;
  }

  .download {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    border-bottom: 1px solid var(--line);
    min-height: 48px;
    padding: 12px 0;
    font-size: clamp(15px, 1vw, 17px);
    transition: color 0.15s ease;
  }

  .downloads .download:last-child {
    border-bottom: 0;
  }

  .download:hover {
    color: var(--rust);
  }

  .downloads-note {
    margin-top: 14px;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }

  .format {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--ink-dim);
  }

  .gallery {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 220px), 1fr));
    gap: 12px;
    margin-top: 32px;
  }

  .photo-cell {
    border: 1px solid var(--line);
    overflow: hidden;
  }

  .gallery :global(img) {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }

  .media-links {
    display: flex;
    flex-wrap: wrap;
    gap: 16px 36px;
    margin-top: 12px;
  }

  .credit {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-dim);
    margin-top: 16px;
  }
</style>
