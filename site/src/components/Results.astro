---
import races from '../data/races.json';
import selected from '../data/selected-results.json';

interface Props {
  /** How many curated rows to show. Clamped to 5–10, as in the prototype. */
  count?: number;
}

const { count = 10 } = Astro.props;
const rows = selected.slice(0, Math.max(5, Math.min(10, count)));

// The header meta is derived from races.json so it can never drift from the data.
const raceCount = races.length;
const firstYear = Math.min(...races.map((race) => race.year));
---

<section id="results">
  <div class="section-inner">
    <h2 class="section-head" data-reveal>
      <span>Selected results</span>
      <span class="meta">
        {raceCount} races since {firstYear} · UltraSignup, iRunFar · WR = world record
      </span>
    </h2>

    <div class="rows" data-reveal-group data-reveal-step="55">
      {
        rows.map((row) => (
          <div class="row" data-reveal>
            <span class="year">{row.year}</span>
            <span class="event">{row.event}</span>
            <span class="detail">{row.detail}</span>
            <span class:list={['place', row.win && 'is-win']}>{row.place}</span>
          </div>
        ))
      }
    </div>

    <a href="/races" class="see-all" data-reveal>All {raceCount} races since {firstYear} →</a>
  </div>
</section>

<style>
  .meta {
    font-weight: 400;
    font-size: 11px;
    letter-spacing: 0.12em;
    opacity: 0.85;
  }

  .rows {
    margin-top: 8px;
  }

  /* Wrapping flex, not a fixed 4-track grid */
  .row {
    display: flex;
    flex-wrap: wrap;
    gap: 8px clamp(16px, 2.5vw, 32px);
    align-items: baseline;
    padding: clamp(16px, 1.8vw, 24px) 10px;
    border-bottom: 1px solid var(--line);
    transition: background-color 0.15s ease;
  }

  .row:hover {
    background: var(--surface-hover);
  }

  .year {
    flex: 0 0 76px;
    font-family: var(--font-mono);
    font-size: clamp(14px, 0.95vw, 16px);
    color: var(--ink-dim);
  }

  .event {
    flex: 1 1 260px;
    font-weight: 600;
    font-size: clamp(19px, 1.25vw, 23px);
    line-height: 1.3;
  }

  .detail {
    flex: 1 1 200px;
    font-family: var(--font-mono);
    font-size: clamp(13px, 0.9vw, 15px);
    color: var(--ink-dim);
  }

  .place {
    flex: 0 0 130px;
    font-family: var(--font-mono);
    font-size: clamp(13px, 0.9vw, 15px);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-dim);
    text-align: right;
  }

  .place.is-win {
    color: var(--rust);
    font-weight: 600;
  }

  @media (max-width: 640px) {
    .place {
      text-align: left;
    }
  }
</style>
