---
import { Image } from 'astro:assets';
import students from '../assets/photos/speaking-students.jpg';
import finishNight from '../assets/photos/badwater-finish-night.jpg';
---

<section id="intro" class="band-deep">
  <div class="intro-inner" data-reveal-group data-reveal-step="90">
    <div data-reveal>
      <div class="eyebrow">Who he is</div>
      <h2>
        Most runners fight the extremes. Harvey Lewis smiles through them.
      </h2>
      <p>
        Thirty years of ultrarunning, fueled entirely by plants and an infectious love for the journey.
        Between 100-mile desert crossings and multi-day world records, he teaches high school American
        government in Cincinnati and reminds every student they are capable of reaching higher than they imagine.
      </p>
      <div class="cta-row">
        <a href="/contact" class="btn btn-solid">Sponsorship &amp; speaking →</a>
        <a href="/media" class="btn btn-outline">Media kit</a>
      </div>
      <div><a href="/story" class="see-all">Read the full story →</a></div>
    </div>

    <div class="intro-photos" data-reveal>
      <div class="photo-frame">
        <Image
          src={students}
          alt="Harvey Lewis speaking with high school students outdoors"
          widths={[400, 800]}
          sizes="(max-width: 700px) 48vw, 360px"
          loading="lazy"
        />
      </div>
      <div class="photo-frame">
        <Image
          src={finishNight}
          alt="Harvey Lewis crossing the Badwater 135 finish line at night with crew and American flag"
          widths={[400, 800]}
          sizes="(max-width: 700px) 48vw, 360px"
          loading="lazy"
        />
      </div>
    </div>
  </div>
</section>

<style>
  .intro-inner {
    max-width: var(--max-w);
    margin: 0 auto;
    padding: var(--section-y) var(--pad-x);
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 440px), 1fr));
    gap: clamp(36px, 6vw, 100px);
    align-items: center;
  }

  h2 {
    margin-top: 24px;
    font-weight: 600;
    font-size: clamp(34px, 3.8vw, 60px);
    line-height: 1.08;
    letter-spacing: -0.02em;
    max-width: 24ch;
  }

  p {
    margin-top: 28px;
    font-size: clamp(18px, 1.2vw, 22px);
    line-height: 1.68;
    color: var(--ink-subtle);
    max-width: 52ch;
    text-wrap: pretty;
  }

  .intro-photos {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
  }

  .photo-frame {
    border: 1px solid var(--line);
    overflow: hidden;
  }

  .photo-frame :global(img) {
    width: 100%;
    height: 100%;
    aspect-ratio: 3 / 4;
    object-fit: cover;
  }
</style>
