  },
  {
    year: '2021',
    outlet: 'iRunFar',
    title: '2021 Badwater 135 Results: Lewis Gains Second Men\'s Win',
    note: 'From an hour down at mile 90 to champion at 45 — 25:50:23.',
    byline: 'Sam Anderson · Jul 21, 2021',
    url: 'https://www.irunfar.com/2021-badwater-135-race-results',
  },
  {
    year: '2021',
    outlet: 'Plant Based News',
    title: 'Vegan Athlete Wins \'World\'s Toughest Race\' for the Second Time',
    note: 'Coverage of the 2021 Badwater win through the plant-based lens.',
    byline: 'Aug 2021',
    url: 'https://plantbasednews.org/culture/sport/vegan-athlete-worlds-toughest-race/',
  },
  {
    year: '2020',
    outlet: 'Cincinnati Enquirer',
    title: '\'Everything Is About the Mental Strength.\' Local Runner Breaks 29-Year-Old World Record',
    note: 'Badwater Basin to Mt. Whitney in 33:32 — breaking Marshall Ulrich\'s 1991 mark.',
    byline: 'Madeline Mitchell · Aug 14, 2020',
    url: 'https://www.cincinnati.com/story/news/2020/08/14/cincinnati-runner-breaks-world-record-runs-lowest-highest-points-u-s/3373809001/',
  },
  {
    year: '2020',
    outlet: 'CityBeat Cincinnati',
    title: 'A Look Inside the Life of Cincinnati Ultramarathon Runner and Educator Harvey Lewis',
    note: 'The immersive profile — CityBeat ran the morning commute with him.',
    byline: 'Nov 2020',
    url: 'https://www.citybeat.com/cincinnati/a-look-inside-the-life-of-cincinnati-ultramarathon-runner-and-educator-harvey-lewis/Slideshow/12233155',
  },
  {
    year: '2020',
    outlet: 'CityBeat Cincinnati',
    title: 'SCPA Teacher Harvey Lewis Is Topic of New Athletic Documentary \'Like Harvey Like Son\'',
    note: 'Documentary preview ahead of the Mariemont Theatre premiere.',
    byline: 'Nov 2020',
    url: 'https://www.citybeat.com/arts/cincinnati-ultramarathon-runner-and-scpa-teacher-harvey-lewis-is-topic-of-new-athletic-documentary-like-harvey-like-son-12169662/',
  },
  {
    year: '2018',
    outlet: 'Cincinnati Enquirer',
    title: 'Cincinnati Teacher Ran 2,198 Miles Under 50 Days',
    note: 'The Appalachian Trail journey, documented as it happened.',
    byline: 'Jul 19, 2018',
    url: 'https://www.cincinnati.com/story/news/2018/07/19/cincinnati-teacher-ran-2-198-miles-under-50-days/799932002/',
  },
  {
    year: '2014',
    outlet: 'WVXU (Cincinnati Public Radio)',
    title: 'SCPA Teacher Wins Badwater Race',
    note: 'The first Badwater win, and the broken-neck story in his own words.',
    byline: 'Jul 22, 2014',
    url: 'https://www.wvxu.org/sports/2014-07-22/scpa-teacher-wins-badwater-race',
  },
  {
    year: '1999',
    outlet: 'Cincinnati Enquirer',
    title: 'Finishing Strong',
    note: 'The earliest known press mention — the same year the Flying Pig streak began.',
    byline: 'May 10, 1999',
    url: null,
  },
];

// Only the five most recent are shown up front; the rest sit behind "Show all".
const PRESS_PREVIEW = 5;
const shownArticles = articles.slice(0, PRESS_PREVIEW);
const restArticles = articles.slice(PRESS_PREVIEW);
---

<Base title="Media & Press — Harvey Lewis" description="The award-winning documentary, press coverage, podcasts, and video features on ultrarunner Harvey Lewis — from 1999 to today.">
  <section class="media-hero">
    <div class="container">
      <p class="eyebrow">Media &amp; Press</p>
      <h1 data-reveal class="media-title">The films, podcasts, <em>and headlines.</em></h1>
      <p data-reveal class="media-sub">
        Interviews, race coverage, documentary films, and audio features from 1999 to today. For press requests, see the <a href="/contact">contact page</a>.
      </p>
    </div>
  </section>

  <!-- ============ DOCUMENTARY ============ -->
  <section class="doc">
    <div class="container doc-grid">
      <div data-reveal class="doc-poster">
        <Image
          src={posterPhoto}
          alt="Two runners on a Death Valley highway wearing shirts reading Your Thoughts Are The Architects Of Your Destiny"
          widths={[480, 720, 1024]}
          sizes="(max-width: 640px) 100vw, 40vw"
          quality={80}
        />
      </div>
      <div data-reveal class="doc-body">
        <p class="mono-label">01 / The Documentary</p>
        <h2 class="doc-title"><em>Like Harvey Like Son</em></h2>
        <p class="doc-award">★ Best Feature Film — Woodbury Film Festival, 2019</p>
        <p class="doc-para">
          In 2018, Harvey Lewis III ran the 2,190-mile Appalachian Trail in 49
          days and 14 hours. His crew chief was his father — Harvey Lewis Jr.,
          then 78 — from whom he had been estranged early in life. The film's
          title carries a double meaning: both men are named Harvey Lewis, and
          the journey from Georgia to Maine is as much a reconciliation as a
          record attempt.
        </p>
        <dl class="doc-facts">
          <div><dt>Director</dt><dd>Rudy Harris Jr.</dd></div>
          <div><dt>Producers</dt><dd>TJ Bitter, Mike Trimpe, Rudy Harris Jr.</dd></div>
          <div><dt>Premiere</dt><dd>Mariemont Theatre, Cincinnati — Nov 2020</dd></div>
          <div><dt>Streaming</dt><dd>Amazon Prime Video</dd></div>
        </dl>
        <div class="doc-links">
          <a class="text-link" href="https://vimeo.com/383788991" rel="noopener">Watch the trailer</a>
          <a class="text-link" href="https://www.likeharveylikeson.com/" rel="noopener">Official site</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ PRESS ============ -->
  <section class="press-section">
    <div class="container">
      <p class="mono-label">02 / In The Press</p>
      <div data-reveal-group data-reveal-step="50" class="press-list">
        {
          shownArticles.map((a) => (
            <article data-reveal class="press-item">
              <span class="press-year">{a.year}</span>
              <div class="press-body">
                <p class="press-outlet">{a.outlet}</p>
                {a.url ? (
                  <a class="press-headline" href={a.url} rel="noopener" target="_blank">
                    {a.title}
                  </a>
                ) : (
                  <span class="press-headline">{a.title}</span>
                )}
                <p class="press-note">{a.note}</p>
                <p class="press-byline">{a.byline}</p>
              </div>
            </article>
          ))
        }

        {
          restArticles.length > 0 && (
            <div class="more-panel" id="press-more">
              {restArticles.map((a) => (
                <article class="press-item">
                  <span class="press-year">{a.year}</span>
                  <div class="press-body">
                    <p class="press-outlet">{a.outlet}</p>
                    {a.url ? (
                      <a class="press-headline" href={a.url} rel="noopener" target="_blank">
                        {a.title}
                      </a>
                    ) : (
                      <span class="press-headline">{a.title}</span>
                    )}
                    <p class="press-note">{a.note}</p>
                    <p class="press-byline">{a.byline}</p>
                  </div>
                </article>
              ))}
            </div>
          )
        }
      </div>

      {
        restArticles.length > 0 && (
          <button
            type="button"
            class="more-toggle"
            data-more-toggle="press-more"
            data-label-more={`Show all ${articles.length} \u2193`}
            data-label-less="Show fewer \u2191"
            aria-expanded="false"
            aria-controls="press-more"
          >
            {`Show all ${articles.length} \u2193`}
          </button>
        )
      }
    </div>
  </section>

  <!-- ============ PODCASTS ============ -->
  <section class="podcasts">
    <div class="container">
      <p class="mono-label">03 / On Air</p>
      <div data-reveal-group data-reveal-step="50" class="podcast-list">
        {
          podcasts.map((p) => (
            <a class="podcast-row" href={p.url} rel="noopener">
              <span class="podcast-show">{p.show}</span>
              <span class="podcast-ep">{p.ep}</span>
              <span class="podcast-date">{p.date}</span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ============ VIDEO ============ -->
  <section class="videos">
    <div class="container">
      <p class="mono-label">04 / On Camera</p>
      <div data-reveal-group data-reveal-step="80" class="video-grid">
        {
          videos.map((v) => (
            <a class="video-card" href={v.url} rel="noopener">
              <div class="video-thumb">
                <Image
                  src={v.thumb}
                  alt={v.alt}
                  widths={[400, 640]}
                  sizes="(max-width: 640px) 100vw, 33vw"
                  quality={80}
                />
              </div>
              <h3 class="video-title">{v.title}</h3>
              <p class="video-sub">{v.sub}</p>
            </a>
          ))
        }
      </div>
    </div>
  </section>
</Base>

<style>
  .media-hero {
    padding: 96px 0 72px;
    border-bottom: 1px solid var(--line);
  }

  .media-title {
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: 64px;
    line-height: 1.03;
    letter-spacing: -0.01em;
    max-width: 860px;
    margin-top: 18px;
  }

  .media-title em {
    font-style: italic;
    font-weight: 340;
    color: var(--rust);
  }

  .doc {
    padding: 88px 0;
    border-bottom: 1px solid var(--line);
  }

  .doc-grid {
    display: grid;
    grid-template-columns: 1fr 1.4fr;
    gap: 56px;
    align-items: start;
  }

  .doc-poster {
    aspect-ratio: 2 / 3;
    overflow: hidden;
    border: 1px solid var(--line);
  }

  .doc-poster img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .doc-title {
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: 44px;
    margin: 14px 0 10px;
  }

  .doc-title em {
    font-style: italic;
  }

  .doc-award {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--rust);
    margin-bottom: 22px;
  }

  .doc-para {
    font-size: 16px;
    line-height: 1.7;
    color: var(--ink-dim);
    max-width: 58ch;
    margin-bottom: 28px;
  }

  .doc-facts {
    border-top: 1px solid var(--line);
    margin-bottom: 28px;
  }

  .doc-facts div {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding: 10px 0;
    border-bottom: 1px solid var(--line);
  }

  .doc-facts dt {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-dim);
    padding-top: 3px;
    white-space: nowrap;
  }

  .doc-facts dd {
    font-size: 14px;
    text-align: right;
  }

  .doc-links {
    display: flex;
    gap: 28px;
  }

  .text-link {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink);
    border-bottom: 1px solid var(--rust);
    padding-bottom: 3px;
  }

  .text-link:hover {
    color: var(--rust);
  }

  .videos {
    padding: 88px 0;
    border-bottom: 1px solid var(--line);
  }

  .video-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 32px;
    margin-top: 36px;
  }

  .video-thumb {
    aspect-ratio: 16 / 9;
    margin-bottom: 16px;
    overflow: hidden;
    border: 1px solid var(--line);
  }

  .video-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .video-card:hover .video-thumb img {
    transform: scale(1.03);
  }

  .video-card:hover .video-title {
    color: var(--rust);
  }

  .video-title {
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: 20px;
    line-height: 1.25;
    margin-bottom: 8px;
  }

  .video-sub {
    font-size: 13px;
    line-height: 1.55;
    color: var(--ink-dim);
  }

  .podcasts {
    padding: 88px 0 112px;
  }

  .podcast-list {
    margin-top: 32px;
    border-top: 1px solid var(--line-strong);
  }

  .podcast-row {
    display: grid;
    grid-template-columns: 240px 1fr 90px;
    gap: 24px;
    padding: 18px 0;
    border-bottom: 1px solid var(--line);
    align-items: baseline;
  }

  .podcast-row:hover .podcast-ep {
    color: var(--rust);
  }

  .podcast-show {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-dim);
  }

  .podcast-ep {
    font-size: 15px;
    color: var(--ink);
  }

  .podcast-date {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--ink-dim);
    text-align: right;
  }

  /* Press section */
  .media-sub {
    font-size: 16px;
    line-height: 1.6;
    color: var(--ink-dim);
    margin-top: 16px;
    max-width: 680px;
  }

  .media-sub a {
    color: var(--ink);
    border-bottom: 1px solid var(--rust);
  }

  .press-section {
    padding: 88px 0;
    border-bottom: 1px solid var(--line);
  }

  .press-list {
    margin-top: 36px;
  }

  .press-item {
    display: grid;
    grid-template-columns: 120px 1fr;
    gap: 32px;
    padding: 30px 0;
    border-bottom: 1px solid var(--line);
  }

  .press-year {
    font-family: var(--font-mono);
    font-size: 14px;
    font-weight: 700;
    color: var(--rust);
    padding-top: 4px;
  }

  .press-outlet {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-dim);
    margin-bottom: 8px;
  }

  .press-headline {
    display: inline-block;
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: 23px;
    line-height: 1.25;
    color: var(--ink);
    max-width: 760px;
    transition: color 0.15s ease;
  }

  a.press-headline:hover {
    color: var(--rust);
  }

  .press-note {
    font-size: 15px;
    color: var(--ink-dim);
    line-height: 1.6;
    margin: 10px 0 6px;
    max-width: 720px;
  }

  .press-byline {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.04em;
    color: var(--ink-dim);
    opacity: 0.75;
  }

  /* Mobile < 640px */
  @media (max-width: 640px) {
    .media-hero {
      padding: 64px 0 56px;
    }

    .media-title {
      font-size: 38px;
    }

    .doc-grid {
      grid-template-columns: 1fr;
      gap: 36px;
    }

    .doc-poster {
      aspect-ratio: 16 / 10;
    }

    .doc-title {
      font-size: 32px;
    }

    .press-item {
      grid-template-columns: 1fr;
      gap: 8px;
